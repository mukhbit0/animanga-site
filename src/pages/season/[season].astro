---
import Base from '../../layouts/Base.astro';
import EntityCard from '../../components/EntityCard.astro';
import { getSeason } from '../../lib/api';

const { season } = Astro.params;

let results = [];
let error = null;

try {
  results = await getSeason(season);
} catch (e) {
  error = e.message;
}

// Format season title for display (e.g., spring-2026 -> Spring 2026)
const displayTitle = season ? season.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ') : '';
---
<Base title={`${displayTitle} Anime`} description={`Explore all anime for the ${displayTitle} season.`}>
  <nav class="text-sm text-neutral-500 mb-6 flex items-center gap-2">
    <a href="/" class="hover:text-[#e85d04]">Home</a>
    <span>/</span>
    <span class="text-neutral-400">{displayTitle}</span>
  </nav>

  <div class="mb-8">
    <h1 class="text-4xl font-black text-white mb-2">{displayTitle} <span class="text-neutral-500">Anime</span></h1>
    <p class="text-neutral-400">Discover all anime airing or released in {displayTitle}.</p>
  </div>

  {error && (
    <div class="bg-red-500/10 border border-red-500/20 p-4 rounded-xl text-red-400 mb-6">
      Error loading season data: {error}
    </div>
  )}

  {results.length === 0 && !error && (
    <div class="glass-dark rounded-2xl p-12 text-center text-neutral-500">
      No anime found for this season.
    </div>
  )}

  {results.length > 0 && (
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      {results.map((item) => (
        <EntityCard entity={item} />
      ))}
    </div>
  )}
</Base>
