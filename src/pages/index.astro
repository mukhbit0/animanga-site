---
import Base from '../layouts/Base.astro';
import EntityCard from '../components/EntityCard.astro';
import { getRewrittenArticles, getTrending, getHype, getCatalog, getJikanData } from '../lib/api';

let articles: any[] = [];
let trending: any[] = [];
let hype: any[] = [];
let animeData: any[] = [];
let mangaData: any[] = [];
let manhwaData: any[] = [];
let manhuaData: any[] = [];
let error: string | null = null;

try {
  const [aRes, tAnimeRes, tMangaRes, hRes, anR, maR, mhR, mcR] = await Promise.all([
    getRewrittenArticles(8),
    getTrending('anime', 30, 10).catch(() => ({ data: [] })),
    getTrending('manga', 30, 10).catch(() => ({ data: [] })),
    getHype(14),
    getCatalog('anime',  'score', '', '', 24).catch(() => ({ data: [] })),
    getCatalog('manga',  'score', '', '', 24).catch(() => ({ data: [] })),
    getCatalog('manhwa', 'score', '', '', 24).catch(() => ({ data: [] })),
    getCatalog('manhua', 'score', '', '', 24).catch(() => ({ data: [] })),
  ]);
  articles   = aRes.data  || [];
  hype       = hRes.data  || [];
  animeData  = anR.data   || [];
  mangaData  = maR.data   || [];
  manhwaData = mhR.data   || [];
  manhuaData = mcR.data   || [];

  // Interleave anime and manga trending items to show a balanced variety
  const tAnime = tAnimeRes.data || [];
  const tManga = tMangaRes.data || [];
  const interleaved: any[] = [];
  const maxLength = Math.max(tAnime.length, tManga.length);
  for (let i = 0; i < maxLength; i++) {
    if (i < tAnime.length) interleaved.push(tAnime[i]);
    if (i < tManga.length) interleaved.push(tManga[i]);
  }
  trending = interleaved.slice(0, 14);

  // Seasonal Fallback via Jikan
  if (!articles.length) {
    const fb = await getJikanData('seasons/now').catch(() => null);
    if (fb?.data) {
      articles = fb.data.slice(0, 8).map((x: any) => ({
        headline: x.title_english || x.title,
        slug: `../entity/${x.mal_id}`,
        featured_image: x.images?.jpg?.large_image_url,
        published_at: new Date().toISOString(),
        created_at: new Date().toISOString(),
        tags: 'Seasonal',
        year: 2026,
        month: 5
      }));
    }
  }

  // Trending Fallback via Jikan (Ensures top 14 items with images)
  if (!trending.length) {
    const fb = await getJikanData('top/anime?filter=airing&limit=14').catch(() => null);
    if (fb?.data) {
      trending = fb.data.slice(0, 14).map((x: any) => ({
        internal_id: x.mal_id,
        type: 'anime',
        title_canonical: x.title_english || x.title,
        year: x.year,
        mal_score: x.score,
        image_url: x.images?.jpg?.large_image_url,
        status: x.status?.toLowerCase().includes('airing') ? 'ongoing' : 'finished',
      }));
    }
  }
} catch (e: any) {
  error = e.message;
}

// Hero collage articles
const heroMain = articles[0];
const heroSec1 = articles[1];
const heroSec2 = articles[2];

const deepDives = articles.slice(3, 7);

function img(u?: string | null) {
  return (!u || u === 'null' || u === 'undefined' || !u.trim())
    ? 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=800&q=80'
    : u;
}

// Robust date formatter to prevent "Invalid Date" RangeError
function formatDate(d: any) {
  if (!d) return new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
  try {
    const date = new Date(d);
    if (isNaN(date.getTime())) {
      return new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
    }
    return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
  } catch (e) {
    return new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
  }
}

// Build collections image pools (handling undefined/null arrays)
function imagePool(data: any[] | null | undefined) {
  if (!Array.isArray(data)) return [];
  return data.filter(d => d && d.image_url && d.image_url !== 'null' && d.image_url !== 'undefined').slice(0, 8).map(d => d.image_url);
}

// Robust tag extractor to prevent crash on undefined/empty array tags
function getDisplayTag(tags: any) {
  if (!tags) return 'News';
  try {
    const rawTag = Array.isArray(tags) ? tags[0] : String(tags).split(',')[0];
    return String(rawTag || 'News').trim() || 'News';
  } catch (e) {
    return 'News';
  }
}

const tabs = [
  { id: 'anime',  title: 'Anime',  data: animeData || [],  images: imagePool(animeData) },
  { id: 'manga',  title: 'Manga',  data: mangaData || [],  images: imagePool(mangaData) },
  { id: 'manhwa', title: 'Manhwa', data: manhwaData || [], images: imagePool(manhwaData) },
  { id: 'manhua', title: 'Manhua', data: manhuaData || [], images: imagePool(manhuaData) },
];
---

<Base title="Home" fullWidth={false}>

{error && <div class="bg-red-500/10 border border-red-500/20 p-4 rounded-xl text-red-400 mb-6 text-sm">{error}</div>}

<!-- ══════════════ CINEMATIC HERO COLLAGE ══════════════ -->
<section style="margin: 0 -1rem 4rem; display: grid; grid-template-columns: 1fr; gap: 1rem;" id="hero-collage">
  
  {/* LEFT / MAIN COLUMN (Big feature) */}
  {heroMain && (
    <div class="hero-block" style="position: relative; height: min(70vh, 560px); border-radius: 1.5rem; overflow: hidden; border: 1px solid rgba(255,255,255,0.08);">
      <img src={img(heroMain.featured_image)} alt="" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%;" />
      <div style="position: absolute; inset: 0; background: linear-gradient(to top, #0a0a0a 0%, rgba(10,10,10,0.85) 35%, rgba(10,10,10,0.2) 70%, transparent 100%);"></div>
      
      <div style="position: relative; z-index: 10; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; padding: 2rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
          <span style="font-size: 9px; background: #e85d04; color: #fff; padding: 3px 10px; border-radius: 999px; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase;">
            {getDisplayTag(heroMain.tags)}
          </span>
          <span style="font-size: 11px; color: rgba(255,255,255,0.5);">
            {formatDate(heroMain.published_at || heroMain.created_at)}
          </span>
        </div>
        <a href={`/news/${heroMain.year || 2026}/${String(heroMain.month || 5).padStart(2,'0')}/${heroMain.slug}`} style="text-decoration: none; display: block; margin-bottom: 1.25rem;">
          <h1 style="font-size: clamp(1.5rem, 3.5vw, 2.5rem); font-weight: 900; color: #fff; line-height: 1.1; margin: 0; text-shadow: 0 2px 20px rgba(0,0,0,0.8); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
            {heroMain.headline || heroMain.title}
          </h1>
        </a>
        <a href={`/news/${heroMain.year || 2026}/${String(heroMain.month || 5).padStart(2,'0')}/${heroMain.slug}`} style="display: inline-flex; align-items: center; gap: 0.5rem; background: #e85d04; color: #fff; font-weight: 900; padding: 0.65rem 1.5rem; border-radius: 0.75rem; font-size: 0.8125rem; text-decoration: none; text-transform: uppercase; width: fit-content; transition: all 0.2s;">
          Read Story <i data-lucide="arrow-right" style="width: 14px; height: 14px;"></i>
        </a>
      </div>
    </div>
  )}

  {/* RIGHT COLUMN (Split secondary features) */}
  <div style="display: grid; grid-template-columns: 1fr; gap: 1rem;" id="hero-sub-grid">
    {heroSec1 && (
      <div class="hero-block" style="position: relative; height: 272px; border-radius: 1.25rem; overflow: hidden; border: 1px solid rgba(255,255,255,0.08);">
        <img src={img(heroSec1.featured_image)} alt="" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;" />
        <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,10,10,0.95) 40%, rgba(10,10,10,0.3) 100%);"></div>
        <div style="position: relative; z-index: 10; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; padding: 1.5rem;">
          <span style="font-size: 9px; color: #e85d04; font-weight: 900; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem;">
            {getDisplayTag(heroSec1.tags)}
          </span>
          <a href={`/news/${heroSec1.year || 2026}/${String(heroSec1.month || 5).padStart(2,'0')}/${heroSec1.slug}`} style="text-decoration: none;">
            <h2 style="font-size: 1.125rem; font-weight: 800; color: #fff; margin: 0; line-height: 1.2;">
              {heroSec1.headline || heroSec1.title}
            </h2>
          </a>
        </div>
      </div>
    )}

    {heroSec2 && (
      <div class="hero-block" style="position: relative; height: 272px; border-radius: 1.25rem; overflow: hidden; border: 1px solid rgba(255,255,255,0.08);">
        <img src={img(heroSec2.featured_image)} alt="" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;" />
        <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,10,10,0.95) 40%, rgba(10,10,10,0.3) 100%);"></div>
        <div style="position: relative; z-index: 10; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; padding: 1.5rem;">
          <span style="font-size: 9px; color: #e85d04; font-weight: 900; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem;">
            {getDisplayTag(heroSec2.tags)}
          </span>
          <a href={`/news/${heroSec2.year || 2026}/${String(heroSec2.month || 5).padStart(2,'0')}/${heroSec2.slug}`} style="text-decoration: none;">
            <h2 style="font-size: 1.125rem; font-weight: 800; color: #fff; margin: 0; line-height: 1.2;">
              {heroSec2.headline || heroSec2.title}
            </h2>
          </a>
        </div>
      </div>
    )}
  </div>
</section>

<!-- ══════════════ TRENDING (Netflix ranking styling) ══════════════ -->
<section style="margin-bottom: 4rem;">
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
    <h2 style="font-size: 1.25rem; font-weight: 900; color: #fff; display: flex; align-items: center; gap: 0.5rem; margin: 0; tracking: -0.01em;">
      <i data-lucide="trending-up" style="width: 20px; height: 20px; color: #e85d04;"></i> Trending This Month
    </h2>
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <a href="/trending?type=anime" style="font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.5); text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#e85d04'" onmouseout="this.style.color='rgba(255,255,255,0.5)'">Anime</a>
      <span style="color: rgba(255,255,255,0.15); font-size: 10px;">|</span>
      <a href="/trending?type=manga" style="font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.5); text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#e85d04'" onmouseout="this.style.color='rgba(255,255,255,0.5)'">Manga</a>
      <span style="color: rgba(255,255,255,0.15); font-size: 10px;">|</span>
      <a href="/trending" style="font-size: 11px; font-weight: 700; color: #e85d04; text-decoration: none; display: flex; align-items: center; gap: 3px;">
        View All <i data-lucide="chevron-right" style="width: 14px; height: 14px;"></i>
      </a>
    </div>
  </div>

  {trending.length > 0 ? (
    <div class="scroll-row" style="padding-bottom: 1.5rem;">
      {trending.map((item: any, i: number) => (
        <div class="rank-card-wrap" style="flex-shrink: 0; width: 17.5rem; position: relative; padding-left: 3.5rem;">
          {/* Brighter rank overlay shifted next to card with hover dynamic changes */}
          <span class="rank-num" style={`position: absolute; left: -0.25rem; bottom: -0.85rem; font-size: 7.5rem; font-weight: 900; line-height: 0.8; color: transparent; -webkit-text-stroke: 2.2px rgba(255,255,255,${i < 3 ? '0.35' : '0.18'}); z-index: 5; pointer-events: none; user-select: none;`}>
            {i + 1}
          </span>
          <div style="position: relative; z-index: 10;">
            <EntityCard entity={item} />
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div style="padding: 2.5rem; border-radius: 1rem; border: 1px solid rgba(255,255,255,0.05); text-align: center; color: rgba(255,255,255,0.3); font-size: 0.875rem;">No trending data available.</div>
  )}
</section>

<!-- ══════════════ HYPE (14-day Radar) ══════════════ -->
{hype.length > 0 && (
<section style="margin-bottom: 4rem; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 3rem;">
  <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
    <h2 style="font-size: 1.25rem; font-weight: 900; color: #fff; display: flex; align-items: center; gap: 0.5rem; margin: 0;">
      <i data-lucide="flame" style="width: 20px; height: 20px; color: #ef4444;"></i> Most Talked About
    </h2>
    <span style="font-size: 11px; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.2); color: #ef4444; padding: 2px 10px; border-radius: 999px; font-weight: 700;">14-day Radar</span>
  </div>
  <div class="scroll-row">
    {hype.map((item: any) => (
      <div style="flex-shrink: 0; width: 15rem; position: relative;">
        <EntityCard entity={item} />
        <div style="position: absolute; bottom: 3.75rem; right: 0.375rem; background: rgba(69,10,10,0.92); border: 1px solid rgba(239,68,68,0.4); color: #fca5a5; font-size: 9px; padding: 2px 6px; border-radius: 999px; font-weight: 700; display: flex; align-items: center; gap: 2px; z-index: 12;">
          <i data-lucide="flame" style="width: 8px; height: 8px;"></i>{item.recent_mentions}
        </div>
      </div>
    ))}
  </div>
</section>
)}

<!-- ══════════════ FEATURED ARTICLES ══════════════ -->
{deepDives.length > 0 && (
<section style="margin-bottom: 4rem; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 3rem;">
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
    <h2 style="font-size: 1.25rem; font-weight: 900; color: #fff; display: flex; align-items: center; gap: 0.5rem; margin: 0;">
      <i data-lucide="award" style="width: 20px; height: 20px; color: #e85d04;"></i> Featured Articles
    </h2>
    <a href="/news" style="font-size: 11px; font-weight: 700; color: #e85d04; text-decoration: none; display: flex; align-items: center; gap: 3px;">
      All News <i data-lucide="chevron-right" style="width: 14px; height: 14px;"></i>
    </a>
  </div>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.5rem;">
    {deepDives.map((a: any) => (
      <a href={`/news/${a.year || 2026}/${String(a.month || 5).padStart(2,'0')}/${a.slug}`}
         style="display: flex; flex-direction: column; background: rgba(255,255,255,0.015); border-radius: 1rem; overflow: hidden; border: 1px solid rgba(255,255,255,0.05); text-decoration: none; transition: border-color 0.2s;"
         class="article-card">
        <div style="aspect-ratio: 16/9; overflow: hidden;">
          <img src={img(a.featured_image)} alt="" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s;" class="article-img" />
        </div>
        <div style="padding: 1.25rem; display: flex; flex-direction: column; flex: 1;">
          <span style="font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: #e85d04; margin-bottom: 0.5rem;">
            {getDisplayTag(a.tags)}
          </span>
          <h3 style="font-size: 0.9375rem; font-weight: 700; color: #fff; margin: 0 0 0.75rem; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
            {a.headline || a.title}
          </h3>
          <div style="display: flex; justify-content: space-between; align-items: center; font-size: 10px; color: rgba(255,255,255,0.35); margin-top: auto; padding-top: 0.75rem; border-top: 1px solid rgba(255,255,255,0.05);">
            <span>{formatDate(a.published_at || a.created_at)}</span>
            <span style="color: #e85d04; font-weight: 700;">Read Story →</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
)}

<!-- ══════════════ COLLECTIONS ══════════════ -->
<section style="border-top: 1px solid rgba(255,255,255,0.05); padding-top: 3rem; margin-bottom: 4rem;">
  <div style="margin-bottom: 2rem;">
    <h2 style="font-size: 1.25rem; font-weight: 900; color: #fff; display: flex; align-items: center; gap: 0.5rem; margin: 0 0 0.25rem;">
      <i data-lucide="library" style="width: 20px; height: 20px; color: #e85d04;"></i> Explore Collections
    </h2>
    <p style="font-size: 0.875rem; color: rgba(255,255,255,0.35); margin: 0;">Top-rated titles across every medium.</p>
  </div>

  {/* Tab buttons */}
  <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-bottom: 2rem;" id="tab-grid">
    {tabs.map((tab, idx) => (
      <button
        id={`btn-${tab.id}`}
        data-target={tab.id}
        data-images={JSON.stringify(tab.images.length ? tab.images : ['https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80'])}
        class="tab-btn"
        style={`position: relative; overflow: hidden; border-radius: 1rem; height: 100px; text-align: left; border: 2px solid ${idx === 0 ? '#e85d04' : 'rgba(255,255,255,0.06)'}; background: transparent; cursor: pointer; padding: 0; transition: border-color 0.3s;`}
      >
        {/* Two overlapping images for smooth, slow 1.2s crossfade transition */}
        <img class="tab-img tab-img-a" src={tab.images[0] || 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80'} alt=""
             style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.42; transition: opacity 1.2s ease-in-out;" />
        <img class="tab-img tab-img-b" src={tab.images[1] || tab.images[0] || 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80'} alt=""
             style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1.2s ease-in-out;" />
        <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(10,10,10,0.68), rgba(10,10,10,0.35));"></div>
        <div style="position: relative; z-index: 10; padding: 1.25rem 1.5rem; height: 100%; display: flex; flex-direction: column; justify-content: flex-end;">
          <span class="tab-title" style={`font-size: 1.5rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.05em; color: ${idx === 0 ? '#e85d04' : '#fff'}; line-height: 1; transition: color 0.3s;`}>
            {tab.title}
          </span>
        </div>
      </button>
    ))}
  </div>

  {/* Tab panels */}
  {tabs.map((tab, idx) => (
    <div id={`panel-${tab.id}`} class="tab-panel" style={idx === 0 ? '' : 'display: none;'}>
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
        <h3 style="font-size: 0.9375rem; font-weight: 700; color: #fff; margin: 0; text-transform: capitalize;">Top {tab.title}</h3>
        <a href={`/${tab.id}`} style="font-size: 11px; font-weight: 700; color: #e85d04; text-decoration: none; display: flex; align-items: center; gap: 3px;">
          Full Catalog <i data-lucide="arrow-right" style="width: 12px; height: 12px;"></i>
        </a>
      </div>
      {tab.data.length > 0 ? (
        <div class="scroll-row">
          {tab.data.map((item: any) => (
            <div style="flex-shrink: 0; width: 14rem;">
              <EntityCard entity={item} />
            </div>
          ))}
        </div>
      ) : (
        <div style="padding: 3rem; text-align: center; color: rgba(255,255,255,0.3); font-size: 0.875rem; border: 1px solid rgba(255,255,255,0.05); border-radius: 1rem;">
          No {tab.title} entries in database yet.
        </div>
      )}
    </div>
  ))}
</section>

</Base>

<style is:global>
/* Netflix rank overlay hover effects and styling */
.rank-card-wrap {
  transition: all 0.3s ease;
}
.rank-num {
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  text-shadow: 0 0 20px rgba(0,0,0,0.8);
}
.rank-card-wrap:hover .rank-num {
  -webkit-text-stroke-color: #e85d04 !important;
  color: rgba(232,93,4,0.08) !important;
  transform: scale(1.1) translateY(-6px);
  filter: drop-shadow(0 0 15px rgba(232, 93, 4, 0.5));
}
.rank-card-wrap:hover {
  transform: translateY(-4px);
}

/* Article card hover */
.article-card:hover { border-color: rgba(232,93,4,0.4) !important; }
.article-card:hover .article-img { transform: scale(1.04); }

/* Grid adjustments for premium collage design */
@media (min-width: 1024px) {
  #hero-collage {
    grid-template-columns: 2fr 1fr !important;
  }
  #hero-sub-grid {
    grid-template-columns: 1fr !important;
    grid-template-rows: 1fr 1fr !important;
  }
  #tab-grid {
    grid-template-columns: repeat(4, 1fr) !important;
  }
}

/* Hero blocks hover glow */
.hero-block {
  transition: border-color 0.3s, transform 0.3s;
}
.hero-block img {
  transition: transform 6s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.hero-block:hover {
  border-color: rgba(232, 93, 4, 0.4) !important;
}
.hero-block:hover img {
  transform: scale(1.04);
}
</style>

<script is:inline>
(function() {
  // Collection tabs functionality
  function setupTabs() {
    var btns = document.querySelectorAll('.tab-btn');
    var panels = document.querySelectorAll('.tab-panel');

    btns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var target = btn.getAttribute('data-target');
        btns.forEach(function(b) {
          b.style.borderColor = 'rgba(255,255,255,0.06)';
          var t = b.querySelector('.tab-title');
          if (t) t.style.color = '#fff';
        });
        btn.style.borderColor = '#e85d04';
        var bt = btn.querySelector('.tab-title');
        if (bt) bt.style.color = '#e85d04';
        panels.forEach(function(p) {
          p.style.display = p.id === 'panel-' + target ? '' : 'none';
        });
      });
    });
  }

  // Smooth crossfade background images - slow 8-second rotation with 1.2s transitions
  function startTabBgRotation() {
    document.querySelectorAll('.tab-btn').forEach(function(btn) {
      try {
        var images = JSON.parse(btn.getAttribute('data-images') || '[]');
        if (images.length < 2) return;
        var imgA = btn.querySelector('.tab-img-a');
        var imgB = btn.querySelector('.tab-img-b');
        if (!imgA || !imgB) return;
        var idx = 0;
        var showA = true;
        
        setInterval(function() {
          idx = (idx + 1) % images.length;
          if (showA) {
            // Load and fade B in smoothly
            imgB.src = images[idx];
            imgA.style.opacity = '0';
            imgB.style.opacity = '0.42';
          } else {
            // Load and fade A in smoothly
            imgA.src = images[idx];
            imgB.style.opacity = '0';
            imgA.style.opacity = '0.42';
          }
          showA = !showA;
        }, 8000); // 8-second rotation
      } catch (e) {}
    });
  }

  setupTabs();
  startTabBgRotation();

  document.addEventListener('astro:page-load', function() {
    setupTabs();
    startTabBgRotation();
  });
})();
</script>
