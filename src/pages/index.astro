---
import Base from '../layouts/Base.astro';
import EntityCard from '../components/EntityCard.astro';
import { getRewrittenArticles, getTrending, getHype, getCatalog, getJikanData } from '../lib/api';

let articles = [];
let trending = [];
let hype = [];
let animeData = [];
let mangaData = [];
let manhwaData = [];
let manhuaData = [];
let error = null;

try {
  const [articlesRes, trendingRes, hypeRes, animeRes, mangaRes, manhwaRes, manhuaRes] = await Promise.all([
    getRewrittenArticles(6),
    getTrending('', 30, 12),
    getHype(12),
    getCatalog('anime',   'score', '', '', 20).catch(() => ({ data: [] })),
    getCatalog('manga',   'score', '', '', 20).catch(() => ({ data: [] })),
    getCatalog('manhwa',  'score', '', '', 20).catch(() => ({ data: [] })),
    getCatalog('manhua',  'score', '', '', 20).catch(() => ({ data: [] }))
  ]);

  articles   = articlesRes.data || [];
  trending   = trendingRes.data || [];
  hype       = hypeRes.data || [];
  animeData  = animeRes.data  || [];
  mangaData  = mangaRes.data  || [];
  manhwaData = manhwaRes.data || [];
  manhuaData = manhuaRes.data || [];

  if (articles.length === 0) {
    const fb = await getJikanData('seasons/now').catch(() => null);
    if (fb?.data) {
      articles = fb.data.slice(0, 6).map((item: any) => ({
        headline:      item.title,
        slug:          `../entity/${item.mal_id}`,
        featured_image: item.images?.jpg?.large_image_url,
        published_at:  new Date().toISOString(),
        created_at:    new Date().toISOString(),
        tags:          'Airing Now, Anime',
      }));
    }
  }

  if (trending.length === 0) {
    const fb = await getJikanData('top/anime').catch(() => null);
    if (fb?.data) {
      trending = fb.data.slice(0, 12).map((item: any) => ({
        internal_id:    item.mal_id,
        type:           'anime',
        title_canonical: item.title,
        year:           item.year,
        mal_score:      item.score,
        image_url:      item.images?.jpg?.large_image_url,
        mention_count:  item.members ? `${(item.members / 1000).toFixed(0)}K` : null,
      }));
    }
  }
} catch (e: any) {
  error = e.message;
}

const featuredArticle = articles[0];
const sideArticles    = articles.slice(1, 4);
const deepDives       = articles.slice(2, 6);

// Pick a random real entity image for each tab background
function randomImage(data: any[], fallback: string) {
  const valid = data.filter((d: any) => d.image_url && d.image_url !== 'null');
  if (valid.length === 0) return fallback;
  return valid[Math.floor(Math.random() * Math.min(valid.length, 5))].image_url;
}

const categoryTabs = [
  { id: 'anime',   title: 'Anime',   data: animeData,   bg: randomImage(animeData,   'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=800&q=80') },
  { id: 'manga',   title: 'Manga',   data: mangaData,   bg: randomImage(mangaData,   'https://images.unsplash.com/photo-1560942485-b2a11cc13456?auto=format&fit=crop&w=800&q=80') },
  { id: 'manhwa',  title: 'Manhwa',  data: manhwaData,  bg: randomImage(manhwaData,  'https://images.unsplash.com/photo-1601987177651-8edfe6c20009?auto=format&fit=crop&w=800&q=80') },
  { id: 'manhua',  title: 'Manhua',  data: manhuaData,  bg: randomImage(manhuaData,  'https://images.unsplash.com/photo-1628157582853-a796fa650a6a?auto=format&fit=crop&w=800&q=80') },
];

function img(url: string | null | undefined) {
  if (!url || url.trim() === '' || url === 'null' || url === 'undefined')
    return 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=800&q=80';
  return url;
}
---

<Base title="Home" fullWidth={false}>

{error && (
  <div class="bg-red-500/10 border border-red-500/20 p-4 rounded-xl text-red-400 mb-6 flex items-center gap-2 text-sm">
    <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0"></i>
    Error loading content: {error}
  </div>
)}

<!-- ════════════════════════════════════════════
     CINEMATIC HERO — full-bleed dramatic reveal
═════════════════════════════════════════════ -->
{featuredArticle && (
  <section class="hero-wrap relative -mx-4 mb-20 overflow-hidden" style="height: min(90vh, 700px);">

    {/* Parallax poster backdrop */}
    <div class="hero-bg absolute inset-0">
      <img
        src={img(featuredArticle.featured_image)}
        alt=""
        aria-hidden="true"
        class="w-full h-full object-cover scale-110 transition-transform duration-[8s] ease-out hero-zoom"
      />
    </div>

    {/* Multi-layered cinematic gradients */}
    <div class="absolute inset-0 bg-gradient-to-r from-[#0a0a0a] via-[#0a0a0a]/60 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-[#0a0a0a]/30"></div>
    <div class="absolute bottom-0 left-0 right-0 h-48 bg-gradient-to-t from-[#0a0a0a] to-transparent"></div>

    {/* Content column — left-aligned cinematic */}
    <div class="relative z-10 h-full flex flex-col justify-end px-6 md:px-16 pb-16 max-w-7xl mx-auto">

      {/* Side articles floating panel */}
      <div class="absolute right-6 md:right-16 top-1/2 -translate-y-1/2 hidden xl:flex flex-col gap-3 w-72">
        <p class="text-[10px] font-bold uppercase tracking-widest text-neutral-500 mb-1">Latest Stories</p>
        {sideArticles.map((a: any) => (
          <a href={`/news/${a.year || 2026}/${String(a.month || 5).padStart(2,'0')}/${a.slug}`}
             class="flex gap-3 bg-[#0a0a0a]/70 backdrop-blur-xl border border-white/8 rounded-xl p-3 hover:border-[#e85d04]/50 transition-all group">
            <img src={img(a.featured_image)} alt={a.headline}
                 class="w-14 h-14 rounded-lg object-cover flex-shrink-0 border border-white/10 group-hover:scale-105 transition-transform duration-300"/>
            <div class="min-w-0 flex flex-col justify-center">
              <p class="text-xs font-bold text-white group-hover:text-[#e85d04] transition-colors line-clamp-2 leading-snug">{a.headline}</p>
              <p class="text-[10px] text-neutral-500 mt-1">{new Date(a.published_at || a.created_at).toLocaleDateString()}</p>
            </div>
          </a>
        ))}
      </div>

      {/* Featured tag + date */}
      <div class="flex items-center gap-3 mb-5 animate-in" style="animation-delay:0.1s">
        <span class="text-[10px] bg-[#e85d04] text-white px-3 py-1 rounded-full font-black uppercase tracking-widest shadow-lg shadow-[#e85d04]/30">
          {Array.isArray(featuredArticle.tags) ? featuredArticle.tags[0] : (featuredArticle.tags?.split(',')[0] || 'News')}
        </span>
        <span class="text-xs text-neutral-400 flex items-center gap-1.5">
          <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
          {new Date(featuredArticle.published_at || featuredArticle.created_at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </span>
      </div>

      {/* Headline — massive cinematic */}
      <a href={`/news/${featuredArticle.year || 2026}/${String(featuredArticle.month || 5).padStart(2,'0')}/${featuredArticle.slug}`} class="group block max-w-3xl mb-6 animate-in" style="animation-delay:0.2s">
        <h1 class="text-4xl md:text-6xl font-black text-white leading-[1.05] tracking-tight group-hover:text-[#e85d04] transition-colors duration-300 drop-shadow-2xl" style="text-shadow: 0 4px 40px rgba(0,0,0,0.8);">
          {featuredArticle.headline}
        </h1>
      </a>

      {/* Excerpt + CTA */}
      <div class="flex items-end gap-6 animate-in" style="animation-delay:0.3s">
        <p class="text-neutral-300 text-sm md:text-base max-w-xl leading-relaxed hidden md:block drop-shadow">
          {featuredArticle.excerpt || "Explore the full breakdown — ratings, character arcs, and franchise metadata inside."}
        </p>
        <a href={`/news/${featuredArticle.year || 2026}/${String(featuredArticle.month || 5).padStart(2,'0')}/${featuredArticle.slug}`}
           class="flex-shrink-0 bg-[#e85d04] hover:bg-[#ff8a3d] text-white font-black px-8 py-3.5 rounded-xl transition-all duration-200 hover:shadow-xl hover:shadow-[#e85d04]/30 hover:-translate-y-0.5 flex items-center gap-2 text-sm uppercase tracking-wide">
          Read Now
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
      </div>
    </div>
  </section>
)}

<!-- ════════════════════════════════════════════
     TRENDING — Netflix style with rank outlines
═════════════════════════════════════════════ -->
<section class="mb-16">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-xl font-black text-white flex items-center gap-2.5 tracking-tight">
      <i data-lucide="trending-up" class="w-5 h-5 text-[#e85d04]"></i>
      Trending This Month
    </h2>
    <a href="/trending" class="text-xs text-[#e85d04] font-bold flex items-center gap-1 hover:text-[#ff8a3d] transition-colors">
      View All <i data-lucide="chevron-right" class="w-4 h-4"></i>
    </a>
  </div>

  {trending.length > 0 ? (
    <div class="scroll-row flex gap-5 pb-2 overflow-x-auto">
      {trending.map((item: any, index: number) => (
        <div class="relative flex-shrink-0 snap-start" style="padding-left: 2.2rem; width: 14rem;">
          <span class="absolute left-0 bottom-0 text-[7rem] font-black select-none pointer-events-none leading-none transition-all duration-500"
                style="-webkit-text-stroke: 1.5px rgba(255,255,255,0.07); color: transparent;">
            {index + 1}
          </span>
          <div class="relative z-10">
            <EntityCard entity={item} />
          </div>
          {item.mention_count && (
            <p class="text-[10px] text-neutral-500 mt-1.5 text-center">{item.mention_count} mentions</p>
          )}
        </div>
      ))}
    </div>
  ) : (
    <div class="glass-dark p-8 rounded-2xl text-center text-neutral-500 border border-white/5">No trending data.</div>
  )}
</section>

<!-- ════════════════════════════════════════════
     HYPE — Most Talked About (14-day radar)
═════════════════════════════════════════════ -->
{hype.length > 0 && (
  <section class="mb-16 border-t border-white/5 pt-10">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-black text-white flex items-center gap-2.5 tracking-tight">
        <i data-lucide="flame" class="w-5 h-5 text-red-500"></i>
        Most Talked About
        <span class="text-red-500 font-normal text-sm">(14-day Radar)</span>
      </h2>
    </div>
    <div class="scroll-row flex gap-5 pb-2 overflow-x-auto">
      {hype.map((item: any) => (
        <div class="relative flex-shrink-0 snap-start" style="width: 14rem;">
          <EntityCard entity={item} />
          <div class="absolute bottom-[3.5rem] right-2 bg-red-950/90 backdrop-blur border border-red-500/20 text-red-400 text-[9px] px-2 py-0.5 rounded-full font-bold flex items-center gap-1">
            <i data-lucide="flame" class="w-2.5 h-2.5"></i>
            {item.recent_mentions}
          </div>
        </div>
      ))}
    </div>
  </section>
)}

<!-- ════════════════════════════════════════════
     DEEP DIVES — Featured article grid
═════════════════════════════════════════════ -->
{deepDives.length > 0 && (
  <section class="mb-16 border-t border-white/5 pt-10">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-black text-white flex items-center gap-2.5 tracking-tight">
        <i data-lucide="award" class="w-5 h-5 text-[#e85d04]"></i>
        Featured Articles
      </h2>
      <a href="/news" class="text-xs text-[#e85d04] font-bold flex items-center gap-1 hover:text-[#ff8a3d] transition-colors">
        All News <i data-lucide="chevron-right" class="w-4 h-4"></i>
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {deepDives.map((article: any) => (
        <a href={`/news/${article.year || 2026}/${String(article.month || 5).padStart(2,'0')}/${article.slug}`}
           class="group flex flex-col bg-white/[0.02] rounded-2xl overflow-hidden border border-white/5 hover:border-[#e85d04]/30 transition-all duration-300">
          <div class="aspect-video overflow-hidden border-b border-white/5">
            <img src={img(article.featured_image)} alt={article.headline}
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"/>
          </div>
          <div class="p-4 flex flex-col flex-grow">
            <span class="text-[10px] font-bold uppercase tracking-widest text-[#e85d04] mb-2">
              {Array.isArray(article.tags) ? article.tags[0] : (article.tags?.split(',')[0] || 'News')}
            </span>
            <h3 class="font-extrabold text-white text-sm group-hover:text-[#e85d04] transition-colors line-clamp-2 mb-2 leading-snug flex-grow">
              {article.headline}
            </h3>
            <div class="flex items-center justify-between text-[10px] text-neutral-500 pt-2 border-t border-white/5 mt-2">
              <span>{new Date(article.published_at || article.created_at).toLocaleDateString()}</span>
              <span class="text-[#e85d04] font-bold group-hover:underline flex items-center gap-0.5">
                Read <i data-lucide="arrow-right" class="w-3 h-3"></i>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<!-- ════════════════════════════════════════════
     MEDIA COLLECTIONS — Image-backed tabs
═════════════════════════════════════════════ -->
<section class="border-t border-white/5 pt-10 mb-16">
  <div class="mb-8">
    <h2 class="text-xl font-black text-white flex items-center gap-2.5 tracking-tight mb-1">
      <i data-lucide="library" class="w-5 h-5 text-[#e85d04]"></i>
      Explore Collections
    </h2>
    <p class="text-neutral-500 text-sm">Top-rated titles across every medium.</p>
  </div>

  <!-- Tab selector row — image-backlit buttons -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    {categoryTabs.map((tab, idx) => (
      <button
        id={`tab-btn-${tab.id}`}
        data-tab-target={tab.id}
        class={`tab-selector-btn relative overflow-hidden rounded-2xl border text-left transition-all duration-300 group ${idx === 0 ? 'active-tab' : ''}`}
        style="height: 110px;"
      >
        {/* Real entity image as faint background */}
        <img
          src={tab.bg}
          alt={tab.title}
          class="absolute inset-0 w-full h-full object-cover opacity-20 group-hover:opacity-30 group-hover:scale-105 transition-all duration-500"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-[#0a0a0a]/80 to-[#0a0a0a]/30"></div>
        <div class="relative z-10 p-5 flex flex-col justify-end h-full">
          <span class="text-2xl font-black uppercase tracking-wider text-white group-hover:text-[#e85d04] transition-colors leading-none">
            {tab.title}
          </span>
          <span class="text-[10px] text-neutral-500 mt-1 font-medium uppercase tracking-widest">
            {tab.data.length} titles
          </span>
        </div>
      </button>
    ))}
  </div>

  <!-- Tab content panels -->
  <div id="tab-panels">
    {categoryTabs.map((tab, idx) => (
      <div id={`tab-content-${tab.id}`}
           class={`tab-content-panel ${idx === 0 ? '' : 'hidden'}`}>
        <div class="flex items-center justify-between mb-5">
          <h3 class="text-base font-bold text-white capitalize">
            Top Rated {tab.title}
          </h3>
          <a href={`/${tab.id}`} class="text-xs font-bold text-[#e85d04] hover:underline flex items-center gap-0.5 uppercase tracking-wide">
            Full Catalog <i data-lucide="arrow-right" class="w-3 h-3"></i>
          </a>
        </div>

        {tab.data.length > 0 ? (
          <div class="scroll-row flex gap-5 pb-2 overflow-x-auto">
            {tab.data.map((item: any) => (
              <div class="flex-shrink-0 snap-start" style="width: 11rem;">
                <EntityCard entity={item} />
              </div>
            ))}
          </div>
        ) : (
          <div class="py-12 text-center text-neutral-500 text-sm flex flex-col items-center gap-2 border border-white/5 rounded-2xl">
            <i data-lucide="inbox" class="w-8 h-8 text-neutral-700"></i>
            No {tab.title} entries found — check your DB has seeded {tab.id} entities.
          </div>
        )}
      </div>
    ))}
  </div>
</section>

</Base>

<style>
/* ── Cinematic hero zoom-in on load ── */
.hero-zoom { animation: heroZoomIn 8s ease-out forwards; }
@keyframes heroZoomIn {
  from { transform: scale(1.15); }
  to   { transform: scale(1.0); }
}

/* ── Animate in children ── */
.animate-in { animation: fadeUp 0.7s ease-out both; }
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(28px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ── Active tab state ── */
.tab-selector-btn { border-color: rgba(255,255,255,0.06); }
.tab-selector-btn.active-tab {
  border-color: #e85d04;
  box-shadow: 0 0 20px rgba(232,93,4,0.18), inset 0 0 0 1px rgba(232,93,4,0.15);
}
.tab-selector-btn.active-tab span:first-of-type { color: #e85d04; }
</style>

<script is:inline>
(function () {
  function setupTabs() {
    const btns   = document.querySelectorAll('.tab-selector-btn');
    const panels = document.querySelectorAll('.tab-content-panel');
    if (!btns.length) return;

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab-target');

        btns.forEach(b => b.classList.remove('active-tab'));
        btn.classList.add('active-tab');

        panels.forEach(p => {
          if (p.id === `tab-content-${target}`) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupTabs);
  document.addEventListener('astro:page-load', setupTabs);
  setupTabs();
})();
</script>
