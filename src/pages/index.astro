---
import Base from '../layouts/Base.astro';
import EntityCard from '../components/EntityCard.astro';
import { getRewrittenArticles, getTrending, getHype, getCatalog, getJikanData } from '../lib/api';

let articles: any[] = [];
let trending: any[] = [];
let hype: any[]     = [];
let animeData: any[]  = [];
let mangaData: any[]  = [];
let manhwaData: any[] = [];
let manhuaData: any[] = [];
let error: string | null = null;

try {
  const [aRes, tRes, hRes, anR, maR, mhR, mcR] = await Promise.all([
    getRewrittenArticles(8),
    getTrending('', 30, 14),
    getHype(14),
    getCatalog('anime',  'score', '', '', 24).catch(() => ({ data: [] })),
    getCatalog('manga',  'score', '', '', 24).catch(() => ({ data: [] })),
    getCatalog('manhwa', 'score', '', '', 24).catch(() => ({ data: [] })),
    getCatalog('manhua', 'score', '', '', 24).catch(() => ({ data: [] })),
  ]);
  articles   = aRes.data  || [];
  trending   = tRes.data  || [];
  hype       = hRes.data  || [];
  animeData  = anR.data   || [];
  mangaData  = maR.data   || [];
  manhwaData = mhR.data   || [];
  manhuaData = mcR.data   || [];

  if (!articles.length) {
    const fb = await getJikanData('seasons/now').catch(() => null);
    if (fb?.data) articles = fb.data.slice(0, 8).map((x: any) => ({
      headline: x.title, slug: `../entity/${x.mal_id}`,
      featured_image: x.images?.jpg?.large_image_url,
      published_at: new Date().toISOString(), created_at: new Date().toISOString(), tags: 'Seasonal',
    }));
  }
  if (!trending.length) {
    const fb = await getJikanData('top/anime').catch(() => null);
    if (fb?.data) trending = fb.data.slice(0, 14).map((x: any) => ({
      internal_id: x.mal_id, type: 'anime', title_canonical: x.title,
      year: x.year, mal_score: x.score, image_url: x.images?.jpg?.large_image_url,
    }));
  }
} catch (e: any) { error = e.message; }

const featuredArticle = articles[0];
// Pass ALL remaining articles as the sidebar pool (rotated by JS)
const sidePool = articles.slice(1, 6);

function img(u?: string | null) {
  return (!u || u === 'null' || u === 'undefined' || !u.trim())
    ? 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=800&q=80'
    : u;
}

// Build image pools per category for JS rotation
function imagePool(data: any[]) {
  return data.filter(d => d.image_url && d.image_url !== 'null').slice(0, 8).map(d => d.image_url);
}

const tabs = [
  { id: 'anime',  title: 'Anime',  data: animeData,  images: imagePool(animeData)  },
  { id: 'manga',  title: 'Manga',  data: mangaData,  images: imagePool(mangaData)  },
  { id: 'manhwa', title: 'Manhwa', data: manhwaData, images: imagePool(manhwaData) },
  { id: 'manhua', title: 'Manhua', data: manhuaData, images: imagePool(manhuaData) },
];

const deepDives = articles.slice(1, 5);
---

<Base title="Home" fullWidth={false}>

{error && <div class="bg-red-500/10 border border-red-500/20 p-4 rounded-xl text-red-400 mb-6 text-sm">{error}</div>}

<!-- ══════════════ CINEMATIC HERO ══════════════ -->
{featuredArticle && (
<section id="hero" class="relative mb-20 -mx-4 overflow-hidden" style="height:min(88vh,720px)">

  <!-- Background image -->
  <img id="hero-bg-img"
    src={img(featuredArticle.featured_image)}
    alt=""
    class="absolute inset-0 w-full h-full object-cover"
    style="transform:scale(1.05); transition:transform 8s ease-out;"
  />

  <!-- Gradient layers -->
  <div class="absolute inset-0" style="background: linear-gradient(to right, #0a0a0a 35%, rgba(10,10,10,0.7) 65%, transparent);"></div>
  <div class="absolute inset-0" style="background: linear-gradient(to top, #0a0a0a 15%, rgba(10,10,10,0.3) 50%, transparent);"></div>
  <div class="absolute top-0 left-0 right-0 h-24" style="background: linear-gradient(to bottom, rgba(10,10,10,0.6), transparent);"></div>

  <!-- Content -->
  <div class="relative z-10 h-full flex flex-col justify-end" style="padding: 0 2.5rem 4rem;">
    <div class="max-w-7xl mx-auto w-full flex items-end justify-between gap-8">

      <!-- LEFT: featured article text -->
      <div class="max-w-2xl">
        <div class="flex items-center gap-3 mb-5">
          <span id="hero-tag" class="text-[10px] bg-[#e85d04] text-white px-3 py-1 rounded-full font-black uppercase tracking-widest">
            {Array.isArray(featuredArticle.tags) ? featuredArticle.tags[0] : (String(featuredArticle.tags || 'News').split(',')[0])}
          </span>
          <span id="hero-date" class="text-xs text-neutral-400">
            {new Date(featuredArticle.published_at || featuredArticle.created_at).toLocaleDateString('en-US', { month:'long', day:'numeric', year:'numeric' })}
          </span>
        </div>

        <a id="hero-link" href={`/news/${featuredArticle.year||2026}/${String(featuredArticle.month||5).padStart(2,'0')}/${featuredArticle.slug}`} class="group block mb-6">
          <h1 id="hero-title" class="font-black text-white leading-tight tracking-tight group-hover:text-[#e85d04] transition-colors"
              style="font-size:clamp(2rem,5vw,3.5rem); text-shadow:0 2px 32px rgba(0,0,0,0.9);">
            {featuredArticle.headline}
          </h1>
        </a>

        <a id="hero-cta" href={`/news/${featuredArticle.year||2026}/${String(featuredArticle.month||5).padStart(2,'0')}/${featuredArticle.slug}`}
           class="inline-flex items-center gap-2 bg-[#e85d04] hover:bg-[#ff8a3d] text-white font-black px-7 py-3 rounded-xl text-sm uppercase tracking-wide transition-all hover:shadow-lg hover:shadow-[#e85d04]/30 hover:-translate-y-0.5">
          Read Now <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
      </div>

      <!-- RIGHT: rotating article sidebar -->
      <div class="hidden xl:flex flex-col gap-3 w-72 flex-shrink-0">
        <p class="text-[10px] font-bold uppercase tracking-widest text-neutral-500 mb-1">Latest Stories</p>
        {sidePool.map((a: any, i: number) => (
          <a href={`/news/${a.year||2026}/${String(a.month||5).padStart(2,'0')}/${a.slug}`}
             class="side-article flex gap-3 bg-black/60 backdrop-blur-xl border border-white/10 rounded-xl p-3 hover:border-[#e85d04]/50 transition-all group"
             style={i > 0 ? 'display:none' : ''}>
            <img src={img(a.featured_image)} alt={a.headline}
                 class="w-14 h-14 rounded-lg object-cover flex-shrink-0 border border-white/10"/>
            <div class="min-w-0 flex flex-col justify-center">
              <p class="text-xs font-bold text-white group-hover:text-[#e85d04] transition-colors line-clamp-2 leading-snug">
                {a.headline || a.title || 'Read Article'}
              </p>
              <p class="text-[10px] text-neutral-500 mt-1">
                {new Date(a.published_at || a.created_at).toLocaleDateString()}
              </p>
            </div>
          </a>
        ))}
      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 opacity-40">
    <span class="text-[10px] text-white uppercase tracking-widest">Scroll</span>
    <i data-lucide="chevron-down" class="w-4 h-4 text-white animate-bounce"></i>
  </div>
</section>
)}

<!-- ══════════════ TRENDING ══════════════ -->
<section class="mb-14">
  <div class="flex items-center justify-between mb-5">
    <h2 class="text-lg font-black text-white flex items-center gap-2">
      <i data-lucide="trending-up" class="w-5 h-5 text-[#e85d04]"></i> Trending This Month
    </h2>
    <a href="/trending" class="text-xs text-[#e85d04] font-bold flex items-center gap-1 hover:underline">
      View All <i data-lucide="chevron-right" class="w-4 h-4"></i>
    </a>
  </div>
  {trending.length > 0 ? (
    <div class="scroll-row">
      {trending.map((item: any, i: number) => (
        <div class="flex-shrink-0 snap-start" style="width:12rem; position:relative; padding-left:1.8rem;">
          <span style="position:absolute;left:-0.5rem;bottom:0;font-size:6rem;font-weight:900;line-height:1;color:transparent;-webkit-text-stroke:1.5px rgba(255,255,255,0.07);user-select:none;pointer-events:none;z-index:0;">
            {i + 1}
          </span>
          <div style="position:relative;z-index:1;">
            <EntityCard entity={item} />
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="glass-dark p-8 rounded-2xl text-center text-neutral-500">No trending data.</div>
  )}
</section>

<!-- ══════════════ HYPE (14-day radar) ══════════════ -->
{hype.length > 0 && (
<section class="mb-14 border-t border-white/5 pt-10">
  <div class="flex items-center gap-3 mb-5">
    <h2 class="text-lg font-black text-white flex items-center gap-2">
      <i data-lucide="flame" class="w-5 h-5 text-red-500"></i> Most Talked About
    </h2>
    <span class="text-xs text-red-500 font-medium">14-day Radar</span>
  </div>
  <div class="scroll-row">
    {hype.map((item: any) => (
      <div class="flex-shrink-0 snap-start" style="width:12rem; position:relative;">
        <EntityCard entity={item} />
        <div style="position:absolute;bottom:3.8rem;right:0.5rem;background:rgba(69,10,10,0.9);border:1px solid rgba(239,68,68,0.3);color:#f87171;font-size:9px;padding:2px 7px;border-radius:999px;font-weight:700;display:flex;align-items:center;gap:3px;">
          <i data-lucide="flame" style="width:9px;height:9px;"></i>{item.recent_mentions}
        </div>
      </div>
    ))}
  </div>
</section>
)}

<!-- ══════════════ FEATURED ARTICLES ══════════════ -->
{deepDives.length > 0 && (
<section class="mb-14 border-t border-white/5 pt-10">
  <div class="flex items-center justify-between mb-5">
    <h2 class="text-lg font-black text-white flex items-center gap-2">
      <i data-lucide="award" class="w-5 h-5 text-[#e85d04]"></i> Featured Articles
    </h2>
    <a href="/news" class="text-xs text-[#e85d04] font-bold flex items-center gap-1 hover:underline">
      All News <i data-lucide="chevron-right" class="w-4 h-4"></i>
    </a>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {deepDives.map((a: any) => (
      <a href={`/news/${a.year||2026}/${String(a.month||5).padStart(2,'0')}/${a.slug}`}
         class="group flex flex-col bg-white/[0.02] rounded-2xl overflow-hidden border border-white/5 hover:border-[#e85d04]/30 transition-all">
        <div class="aspect-video overflow-hidden">
          <img src={img(a.featured_image)} alt={a.headline} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"/>
        </div>
        <div class="p-4 flex flex-col flex-grow">
          <span class="text-[10px] font-bold uppercase tracking-widest text-[#e85d04] mb-2">
            {Array.isArray(a.tags) ? a.tags[0] : (String(a.tags||'News').split(',')[0])}
          </span>
          <h3 class="font-bold text-white text-sm group-hover:text-[#e85d04] transition-colors line-clamp-2 leading-snug flex-grow">
            {a.headline || a.title}
          </h3>
          <div class="flex justify-between items-center text-[10px] text-neutral-500 pt-3 border-t border-white/5 mt-3">
            <span>{new Date(a.published_at||a.created_at).toLocaleDateString()}</span>
            <span class="text-[#e85d04] font-bold">Read →</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
)}

<!-- ══════════════ COLLECTIONS TABS ══════════════ -->
<section class="border-t border-white/5 pt-10 mb-16">
  <div class="mb-6">
    <h2 class="text-lg font-black text-white flex items-center gap-2 mb-1">
      <i data-lucide="library" class="w-5 h-5 text-[#e85d04]"></i> Explore Collections
    </h2>
    <p class="text-neutral-500 text-sm">Top-rated titles across every medium.</p>
  </div>

  <!-- Tab buttons with rotating real entity images -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    {tabs.map((tab, idx) => (
      <button
        id={`tab-btn-${tab.id}`}
        data-tab-target={tab.id}
        data-images={JSON.stringify(tab.images.length ? tab.images : ['https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80'])}
        class={`tab-btn relative overflow-hidden rounded-2xl text-left group ${idx===0?'tab-btn-active':''}`}
        style="height:100px;"
      >
        <!-- Rotating background image -->
        <img
          class="tab-bg-img absolute inset-0 w-full h-full object-cover"
          src={tab.images[0] || 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80'}
          alt=""
          style="opacity:0.38;"
        />
        <div class="absolute inset-0" style="background:linear-gradient(135deg,rgba(10,10,10,0.75),rgba(10,10,10,0.45));"></div>
        <!-- Active glow border overlay -->
        <div class="tab-border absolute inset-0 rounded-2xl border-2 pointer-events-none" style={idx===0?'border-color:#e85d04;box-shadow:0 0 18px rgba(232,93,4,0.2)':'border-color:rgba(255,255,255,0.06)'}></div>
        <div class="relative z-10 p-4 flex flex-col justify-end h-full">
          <span class="text-xl font-black uppercase tracking-wider text-white" style={idx===0?'color:#e85d04':''}>
            {tab.title}
          </span>
        </div>
      </button>
    ))}
  </div>

  <!-- Tab content panels -->
  {tabs.map((tab, idx) => (
    <div id={`tab-content-${tab.id}`} class={`tab-panel ${idx===0?'':'hidden'}`}>
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-bold text-white capitalize">Top {tab.title}</h3>
        <a href={`/${tab.id}`} class="text-xs font-bold text-[#e85d04] hover:underline flex items-center gap-0.5">
          Full Catalog <i data-lucide="arrow-right" class="w-3 h-3"></i>
        </a>
      </div>
      {tab.data.length > 0 ? (
        <div class="scroll-row">
          {tab.data.map((item: any) => (
            <div class="flex-shrink-0 snap-start" style="width:10rem;">
              <EntityCard entity={item} />
            </div>
          ))}
        </div>
      ) : (
        <div class="py-10 text-center text-neutral-500 text-sm border border-white/5 rounded-2xl">
          No {tab.title} entries in database yet.
        </div>
      )}
    </div>
  ))}
</section>

</Base>

<!-- Pass side articles data to JS for rotation -->
<script is:inline define:vars={{ sidePoolData: sidePool }}>
  (function() {
    // ── Side article rotation in hero ──────────────────────
    var pool = sidePoolData;
    var idx  = 0;

    function rotateSideArticles() {
      var articles = document.querySelectorAll('.side-article');
      if (!articles.length || pool.length < 2) return;
      articles.forEach(function(el) { el.style.display = 'none'; });
      idx = (idx + 1) % articles.length;
      articles[idx].style.display = 'flex';
    }

    setInterval(rotateSideArticles, 4000);

    // ── Collection tab logic ───────────────────────────────
    function setupTabs() {
      var btns   = document.querySelectorAll('.tab-btn');
      var panels = document.querySelectorAll('.tab-panel');
      if (!btns.length) return;

      btns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var target = btn.getAttribute('data-tab-target');

          btns.forEach(function(b) {
            b.classList.remove('tab-btn-active');
            var border = b.querySelector('.tab-border');
            if (border) { border.style.borderColor = 'rgba(255,255,255,0.06)'; border.style.boxShadow = ''; }
            var title = b.querySelector('span');
            if (title) title.style.color = 'white';
          });

          btn.classList.add('tab-btn-active');
          var activeBorder = btn.querySelector('.tab-border');
          if (activeBorder) { activeBorder.style.borderColor = '#e85d04'; activeBorder.style.boxShadow = '0 0 18px rgba(232,93,4,0.2)'; }
          var activeTitle = btn.querySelector('span');
          if (activeTitle) activeTitle.style.color = '#e85d04';

          panels.forEach(function(p) {
            p.classList.toggle('hidden', p.id !== 'tab-content-' + target);
          });
        });
      });
    }

    // ── Tab bg image rotation ──────────────────────────────
    var tabBgTimers = {};

    function startTabBgRotation() {
      document.querySelectorAll('.tab-btn').forEach(function(btn) {
        var id = btn.getAttribute('data-tab-target');
        try {
          var images = JSON.parse(btn.getAttribute('data-images') || '[]');
          if (images.length < 2) return;
          var i = 0;
          if (tabBgTimers[id]) clearInterval(tabBgTimers[id]);
          tabBgTimers[id] = setInterval(function() {
            var bgImg = btn.querySelector('.tab-bg-img');
            if (!bgImg) return;
            i = (i + 1) % images.length;
            bgImg.style.opacity = '0';
            setTimeout(function() {
              bgImg.src = images[i];
              bgImg.style.opacity = '0.38';
            }, 300);
          }, 3500);
        } catch(e) {}
      });
    }

    // ── Hero bg subtle zoom start ──────────────────────────
    function startHeroZoom() {
      var bg = document.getElementById('hero-bg-img');
      if (bg) { setTimeout(function() { bg.style.transform = 'scale(1.0)'; }, 100); }
    }

    function init() {
      setupTabs();
      startTabBgRotation();
      startHeroZoom();
    }

    document.addEventListener('DOMContentLoaded', init);
    document.addEventListener('astro:page-load', init);
    init();
  })();
</script>
