---
import Base from '../layouts/Base.astro';
import EntityCard from '../components/EntityCard.astro';
import { searchEntities, getTrending, getCatalog } from '../lib/api';

const q = Astro.url.searchParams.get('q') || '';
const typeParam = Astro.url.searchParams.get('type') || '';

let results = [];
let trending = [];
let error = null;

let animeBg = 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80';
let mangaBg = 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80';
let manhwaBg = 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80';
let manhuaBg = 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80';

if (q) {
  try {
    const response = await searchEntities(q, typeParam);
    results = response.data || [];
  } catch (e) {
    error = e.message;
  }
} else {
  // Empty state: show trending and fetch background covers for type cards
  try {
    const [trendingRes, anR, maR, mhR, mcR] = await Promise.all([
      getTrending('', 30, 8).catch(() => ({ data: [] })),
      getCatalog('anime',  'score', '', '', 1).catch(() => null),
      getCatalog('manga',  'score', '', '', 1).catch(() => null),
      getCatalog('manhwa', 'score', '', '', 1).catch(() => null),
      getCatalog('manhua', 'score', '', '', 1).catch(() => null),
    ]);
    trending = trendingRes.data || [];
    if (anR?.data?.[0]?.image_url) animeBg = anR.data[0].image_url;
    if (maR?.data?.[0]?.image_url) mangaBg = maR.data[0].image_url;
    if (mhR?.data?.[0]?.image_url) manhwaBg = mhR.data[0].image_url;
    if (mcR?.data?.[0]?.image_url) manhuaBg = mcR.data[0].image_url;
  } catch (e) {}
}

const typeTabs = [
  { label: 'All', value: '' },
  { label: 'Anime', value: 'anime' },
  { label: 'Manga', value: 'manga' },
  { label: 'Manhwa', value: 'manhwa' },
  { label: 'Manhua', value: 'manhua' },
];
---
<Base title={q ? `"${q}" — Search` : 'Search'} description="Search for anime and manga.">
  
  <style>
    .search-type-card:hover .type-card-img {
      transform: scale(1.08);
    }
    .search-type-card:hover .type-card-title {
      color: #e85d04 !important;
    }
    .search-type-card:hover {
      box-shadow: 0 0 15px rgba(232, 93, 4, 0.15);
    }
  </style>

  {/* Search Bar */}
  <div class="mb-8">
    <h1 class="text-4xl font-black text-white mb-6">Search</h1>
    <form action="/search" method="GET" class="relative mb-4">
      <input type="hidden" name="type" value={typeParam} />
      <input 
         type="text" 
         name="q" 
         value={q} 
         placeholder="Search anime, manga, manhwa, manhua..." 
         class="w-full bg-white/5 border border-white/10 rounded-xl px-6 py-4 pl-12 text-white placeholder-neutral-500 focus:outline-none focus:border-[#e85d04]/50 focus:ring-2 focus:ring-[#e85d04]/20 transition-all text-lg"
         autofocus
      />
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 absolute left-4 top-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </form>

    {/* Type Tabs */}
    <div class="flex gap-2">
      {typeTabs.map((tab) => (
        <a 
          href={`/search?q=${encodeURIComponent(q)}${tab.value ? '&type=' + tab.value : ''}`}
          class={`px-4 py-2 rounded-lg text-sm font-medium transition-all ${typeParam === tab.value ? 'bg-[#e85d04] text-white' : 'bg-white/5 text-neutral-400 hover:text-white hover:bg-white/10'}`}
        >
          {tab.label}
        </a>
      ))}
    </div>
  </div>

  {error && (
    <div class="bg-red-500/10 border border-red-500/20 p-4 rounded-xl text-red-400 mb-6">
      Error performing search: {error}
    </div>
  )}

  {/* Results */}
  {q && results.length > 0 && (
    <div>
      <p class="text-sm text-neutral-500 mb-6">{results.length} results for "<span class="text-white">{q}</span>"</p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {results.map((item) => (
          <EntityCard entity={item} />
        ))}
      </div>
    </div>
  )}

  {/* No Results */}
  {q && results.length === 0 && !error && (
    <div class="glass-dark rounded-2xl p-12 text-center">
      <p class="text-xl text-neutral-400 mb-2">No results for "<span class="text-white">{q}</span>"</p>
      <p class="text-sm text-neutral-600">Try a different search term or browse by type below.</p>
    </div>
  )}

  {/* Empty State */}
  {!q && (
    <div>
      {trending.length > 0 && (
        <div class="mb-10">
          <h2 class="text-lg font-bold text-white mb-4">🔥 Trending Searches</h2>
          <div class="flex flex-wrap gap-2">
            {trending.map((item) => (
              <a href={`/search?q=${encodeURIComponent(item.title_canonical)}`} class="bg-white/5 border border-white/10 text-neutral-300 px-4 py-2 rounded-full text-sm font-medium hover:bg-[#e85d04]/10 hover:text-[#e85d04] hover:border-[#e85d04]/30 transition-all">
                {item.title_canonical}
              </a>
            ))}
          </div>
        </div>
      )}

      <div>
        <h2 class="text-lg font-bold text-white mb-4">Browse by Type</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {[
            { id: 'anime', title: 'Anime', img: animeBg },
            { id: 'manga', title: 'Manga', img: mangaBg },
            { id: 'manhwa', title: 'Manhwa', img: manhwaBg },
            { id: 'manhua', title: 'Manhua', img: manhuaBg }
          ].map((tab) => (
            <a
              href={`/search?type=${tab.id}`}
              style="position: relative; overflow: hidden; border-radius: 1rem; height: 100px; text-align: left; border: 2px solid rgba(255,255,255,0.06); background: transparent; cursor: pointer; padding: 0; display: block; transition: all 0.3s ease;"
              class="search-type-card hover:border-[#e85d04]"
            >
              <img src={tab.img} alt="" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.42; transition: transform 0.5s ease;" class="type-card-img" />
              <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(10,10,10,0.68), rgba(10,10,10,0.35));"></div>
              <div style="position: relative; z-index: 10; padding: 1.25rem 1.5rem; height: 100%; display: flex; flex-direction: column; justify-content: flex-end;">
                <span style="font-size: 1.5rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.05em; color: #fff; line-height: 1; transition: color 0.3s;" class="type-card-title">
                  {tab.title}
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  )}
</Base>
