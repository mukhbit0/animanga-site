---
import Base from '../../layouts/Base.astro';
import EntityCard from '../../components/EntityCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { 
  getEntity, 
  getEntityRecommendations, 
  getRewrittenArticlesByEntity,
  getEntityEpisodes,
  getEntityCharacters,
  getEntityScreenshots,
  getEntityArtworks
} from '../../lib/api';

const { id } = Astro.params;

let entity = null;
let recommendations = [];
let articles = [];
let episodes = [];
let characters = [];
let screenshots = [];
let artworks = [];
let error = null;

try {
  const entityRes = await getEntity(id);
  entity = entityRes.data;
  
  if (entity) {
    const promises = [
      getEntityRecommendations(id, '', 12).catch(() => ({ data: [] })),
      getRewrittenArticlesByEntity(id, 6).catch(() => ({ data: [] })),
      getEntityEpisodes(id).catch(() => ({ data: [] })),
      getEntityCharacters(id).catch(() => ({ data: [] })),
      getEntityScreenshots(id).catch(() => ({ data: [] })),
      getEntityArtworks(id).catch(() => ({ data: [] }))
    ];
    
    const results = await Promise.all(promises);
    
    recommendations = results[0].data || [];
    articles = results[1].data || [];
    episodes = results[2].data || [];
    characters = results[3].data || [];
    screenshots = results[4].data || [];
    artworks = results[5].data || [];
  }
} catch (e) {
  error = e.message;
}

const details = entity?.details || {};
const tags = entity?.tags || [];
const genres = details.genres ? details.genres.split(', ') : [];

const displayFormat = details.format;
const displayStatus = details.status;
const displayEpisodes = details.episodes;
const displayDuration = details.duration;
const displayRating = details.age_rating;
const displaySeason = details.season ? `${details.season} ${details.season_year || ''}` : null;
const displayStudios = details.studios;
const displayAuthors = details.authors;
const displayPublisher = details.publisher;
const displaySerialization = details.serialization;

// Schema
const entitySchema = entity ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": entity.type === 'anime' ? "TVSeries" : "Book",
  "name": entity.title_canonical,
  "description": details.synopsis?.slice(0, 200),
  "image": details.image_url,
  "datePublished": entity.year ? `${entity.year}` : undefined,
  "genre": genres,
  "aggregateRating": details.mal_score ? {
    "@type": "AggregateRating",
    "ratingValue": details.mal_score,
    "bestRating": 10,
    "ratingCount": details.mal_scored_by || 0
  } : undefined
}) : null;

// FAQ items
const faqItems = [];
if (entity) {
  if (details.status) {
    faqItems.push({
      question: `Is ${entity.title_canonical} finished?`,
      answer: details.status === 'completed' 
        ? `Yes, ${entity.title_canonical} has been completed.` 
        : details.status === 'ongoing' 
        ? `No, ${entity.title_canonical} is still ongoing.` 
        : `${entity.title_canonical} is currently listed as "${details.status}".`
    });
  }
  if (details.episodes) {
    faqItems.push({
      question: `How many episodes does ${entity.title_canonical} have?`,
      answer: `${entity.title_canonical} has ${details.episodes} episodes.`
    });
  }
}

const faqSchema = faqItems.length > 0 ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer }
  }))
}) : null;

// Dynamic brand coloring
const brandColor = details.color || '#e85d04';
---
<Base 
  title={entity?.title_canonical || 'Entity Not Found'} 
  description={details.synopsis?.slice(0, 160) || `Details for ${entity?.title_canonical}`}
  schema={entitySchema}
>
  {faqSchema && <script type="application/ld+json" set:html={faqSchema}></script>}
  
  {error && (
    <div class="bg-red-500/10 border border-red-500/20 p-4 rounded-xl text-red-400 mb-6">
      Error loading entity: {error}
    </div>
  )}

  {entity ? (
    <div style={`--brand-color: ${brandColor};`}>
      {/* Breadcrumb */}
      <nav class="text-sm text-neutral-500 mb-6 flex items-center gap-2">
        <a href="/" class="hover:text-[var(--brand-color)]">Home</a>
        <span>/</span>
        <a href={`/search?type=${entity.type}`} class="hover:text-[var(--brand-color)] capitalize">{entity.type}</a>
        <span>/</span>
        <span class="text-neutral-400 truncate max-w-xs">{entity.title_canonical}</span>
      </nav>

      {/* Widescreen Banner Backdrop */}
      {details.background && (
        <div class="relative w-full h-[220px] md:h-[350px] overflow-hidden rounded-3xl mb-8 border border-white/5 shadow-2xl">
          <div 
            class="absolute inset-0 bg-cover bg-center filter brightness-50 contrast-125 scale-105" 
            style={`background-image: url(${details.background});`}
          ></div>
          <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-[#0a0a0a]/50"></div>
          {details.background_attribution && (
            <div class="absolute bottom-4 right-4 text-[10px] text-white/40 bg-black/40 px-2 py-1 rounded backdrop-blur">
              {details.background_attribution}
            </div>
          )}
        </div>
      )}

      {/* Hero Card */}
      <div class="bg-[#111] rounded-2xl border border-white/5 p-6 md:p-8 mb-8 relative z-10 -mt-20 md:-mt-32 backdrop-blur-md bg-opacity-95 shadow-2xl mx-4 md:mx-6">
        <div class="flex flex-col md:flex-row gap-6">
          {/* Cover with Fallback */}
          <div class="w-48 h-72 rounded-xl overflow-hidden flex-shrink-0 shadow-2xl mx-auto md:mx-0 bg-neutral-900 border border-white/10 -mt-16 md:-mt-24 relative z-20">
            <img 
              src={details.image_url && details.image_url.trim() !== "" && details.image_url !== "null" && details.image_url !== "undefined" ? details.image_url : 'https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?auto=format&fit=crop&w=400&q=80'} 
              alt={entity.title_canonical} 
              class="w-full h-full object-cover" 
            />
          </div>
          
          <div class="flex-grow">
            {/* Type + Year */}
            <div class="flex items-center gap-2 mb-2 justify-center md:justify-start">
              <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-[var(--brand-color)]/20 text-[var(--brand-color)] border border-[var(--brand-color)]/10`}>
                {entity.type}
              </span>
              {entity.year && <span class="text-sm text-neutral-400 font-medium">{entity.year}</span>}
              {details.format && <span class="text-sm text-neutral-500 font-medium">· {details.format}</span>}
            </div>

            <h1 class="text-3xl md:text-4xl font-black text-white mb-1 leading-tight text-center md:text-left">{entity.title_canonical}</h1>
            {entity.title_original && (
              <p class="text-neutral-500 mb-4 text-center md:text-left font-medium">{entity.title_original}</p>
            )}

            {/* Stats Row */}
            <div class="flex flex-wrap gap-4 mb-6 justify-center md:justify-start">
              {details.mal_score && (
                <div class="bg-white/5 rounded-xl px-4 py-2 text-center border border-white/5">
                  <div class="flex items-center gap-1 text-xl font-bold text-white justify-center">
                    <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    {details.mal_score}
                  </div>
                  <div class="text-[10px] text-neutral-500 uppercase tracking-wider font-semibold">MAL Score</div>
                </div>
              )}
              {details.favorites && (
                <div class="bg-white/5 rounded-xl px-4 py-2 text-center border border-white/5">
                  <div class="text-xl font-bold text-white flex items-center justify-center gap-1">
                    <svg class="w-5 h-5 text-pink-500" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
                    </svg>
                    {details.favorites.toLocaleString()}
                  </div>
                  <div class="text-[10px] text-neutral-500 uppercase tracking-wider font-semibold">Favorites</div>
                </div>
              )}
              {details.trending && (
                <div class="bg-white/5 rounded-xl px-4 py-2 text-center border border-white/5">
                  <div class="text-xl font-bold text-white flex items-center justify-center gap-1">
                    <svg class="w-5 h-5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L10 10.586 13.586 7H12z" clip-rule="evenodd"/>
                    </svg>
                    {details.trending.toLocaleString()}
                  </div>
                  <div class="text-[10px] text-neutral-500 uppercase tracking-wider font-semibold">Trending</div>
                </div>
              )}
              {displayEpisodes && (
                <div class="bg-white/5 rounded-xl px-4 py-2 text-center border border-white/5">
                  <div class="text-xl font-bold text-white">{displayEpisodes}</div>
                  <div class="text-[10px] text-neutral-500 uppercase tracking-wider font-semibold">Episodes</div>
                </div>
              )}
              {displayStatus && (
                <div class="bg-white/5 rounded-xl px-4 py-2 text-center border border-white/5">
                  <div class={`text-xl font-bold capitalize ${displayStatus === 'ongoing' ? 'text-green-400' : 'text-neutral-300'}`}>{displayStatus}</div>
                  <div class="text-[10px] text-neutral-500 uppercase tracking-wider font-semibold">Status</div>
                </div>
              )}
            </div>

            {/* Genres */}
            {genres.length > 0 && (
              <div class="flex flex-wrap gap-2 justify-center md:justify-start">
                {genres.map((genre) => (
                  <a 
                    href={`/tag/${encodeURIComponent(genre.trim())}`} 
                    class="text-xs bg-white/5 text-neutral-400 px-3 py-1.5 rounded-full font-medium hover:bg-[var(--brand-color)]/10 hover:text-[var(--brand-color)] border border-white/5 transition-all"
                  >
                    {genre.trim()}
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>

      {/* Tabs Selector */}
      <div class="flex gap-2 border-b border-white/10 mb-8 overflow-x-auto pb-px scrollbar-thin">
        <button 
          class="tab-btn active px-5 py-3 border-b-2 font-bold text-sm text-[var(--brand-color)] border-[var(--brand-color)] bg-[var(--brand-color)]/10 rounded-t-xl transition-all whitespace-nowrap" 
          data-tab="overview"
        >
          Overview
        </button>
        {episodes.length > 0 && (
          <button 
            class="tab-btn px-5 py-3 border-b-2 border-transparent font-bold text-sm text-neutral-400 hover:text-white rounded-t-xl transition-all whitespace-nowrap" 
            data-tab="episodes"
          >
            Episodes ({episodes.length})
          </button>
        )}
        {characters.length > 0 && (
          <button 
            class="tab-btn px-5 py-3 border-b-2 border-transparent font-bold text-sm text-neutral-400 hover:text-white rounded-t-xl transition-all whitespace-nowrap" 
            data-tab="characters"
          >
            Characters ({characters.length})
          </button>
        )}
        {(screenshots.length > 0 || artworks.length > 0) && (
          <button 
            class="tab-btn px-5 py-3 border-b-2 border-transparent font-bold text-sm text-neutral-400 hover:text-white rounded-t-xl transition-all whitespace-nowrap" 
            data-tab="media"
          >
            Media ({screenshots.length + artworks.length})
          </button>
        )}
      </div>

      {/* Tab Contents */}
      
      {/* ── OVERVIEW TAB ── */}
      <div id="tab-overview" class="tab-content block">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="md:col-span-2">
            {/* Synopsis */}
            {details.synopsis && (
              <section class="mb-8 bg-[#111] p-6 rounded-2xl border border-white/5 shadow-lg">
                <h2 class="text-xl font-bold text-white mb-4 border-b border-white/5 pb-2">Synopsis</h2>
                <p class="text-neutral-400 leading-relaxed whitespace-pre-line max-w-full text-sm md:text-base">{details.synopsis}</p>
              </section>
            )}

            {/* Trailer */}
            {details.trailer_url && (
              <section class="mb-8 bg-[#111] p-6 rounded-2xl border border-white/5 shadow-lg">
                <h2 class="text-xl font-bold text-white mb-4 border-b border-white/5 pb-2">Official Trailer</h2>
                <div class="aspect-video w-full rounded-xl overflow-hidden border border-white/10 shadow-inner">
                  {details.trailer_url.includes('youtube.com') || details.trailer_url.includes('youtu.be') ? (
                    <iframe 
                      src={`https://www.youtube.com/embed/${details.trailer_url.match(/(?:v=|\/)([\w-]{11})/)?.[1] || ''}`}
                      class="w-full h-full" 
                      allowfullscreen
                      loading="lazy"
                    ></iframe>
                  ) : (
                    <iframe 
                      src={details.trailer_url} 
                      class="w-full h-full" 
                      allowfullscreen
                      loading="lazy"
                    ></iframe>
                  )}
                </div>
              </section>
            )}

            {/* AI Character Chat Widget */}
            <section class="mb-8 bg-white/5 rounded-2xl p-6 border border-white/5 shadow-lg backdrop-blur">
              <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                <span>💬 Chat with AI Representation</span>
                <span class="text-xs bg-[var(--brand-color)]/25 text-[var(--brand-color)] border border-[var(--brand-color)]/10 px-2 py-0.5 rounded font-bold uppercase tracking-wider">AI Character</span>
              </h2>
              <div class="space-y-4 h-64 overflow-y-auto mb-4 p-4 bg-black/40 rounded-xl border border-white/5 scrollbar-thin" id="chat-messages">
                <div class="text-sm text-neutral-400 leading-relaxed bg-white/5 p-3 rounded-lg border border-white/5">
                  <span class="font-bold text-[var(--brand-color)] block mb-0.5">AI Representation:</span> 
                  Hello! I am an AI representation trained on all existing data for <span class="text-white font-semibold">{entity.title_canonical}</span>. Ask me anything about the synopsis, characters, lore, or production details!
                </div>
              </div>
              <div class="flex gap-2">
                <input 
                  type="text" 
                  id="chat-input" 
                  placeholder={`Ask me anything about ${entity.title_canonical}...`} 
                  class="flex-grow bg-white/5 text-white text-sm rounded-lg border border-white/10 px-4 py-2.5 focus:border-[var(--brand-color)] focus:ring-1 focus:ring-[var(--brand-color)] focus:outline-none transition-all placeholder-neutral-500"
                />
                <button 
                  id="send-btn" 
                  class="bg-[var(--brand-color)] text-white px-5 py-2.5 rounded-lg text-sm font-bold hover:opacity-90 active:scale-95 transition-all shadow-md"
                  data-id={id}
                >
                  Send
                </button>
              </div>
            </section>
          </div>

          {/* Sidebar Information */}
          <div class="bg-[#111] rounded-2xl border border-white/5 p-6 h-fit shadow-lg">
            <h2 class="text-xl font-bold text-white mb-4 border-b border-white/5 pb-2">Information</h2>
            <div class="space-y-4 text-sm">
              {displayFormat && (
                <div>
                  <span class="text-neutral-500 block mb-0.5 font-semibold uppercase tracking-wider text-[10px]">Format</span>
                  <span class="text-white font-bold uppercase text-xs bg-white/5 border border-white/5 px-2 py-1 rounded inline-block">{displayFormat}</span>
                </div>
              )}
              {displayStatus && (
                <div>
                  <span class="text-neutral-500 block mb-0.5 font-semibold uppercase tracking-wider text-[10px]">Status</span>
                  <span class="text-white font-medium capitalize">{displayStatus}</span>
                </div>
              )}
              {displaySeason && (
                <div>
                  <span class="text-neutral-500 block mb-0.5 font-semibold uppercase tracking-wider text-[10px]">Season</span>
                  <span class="text-white font-medium capitalize">{displaySeason}</span>
                </div>
              )}
              {displayDuration && (
                <div>
                  <span class="text-neutral-500 block mb-0.5 font-semibold uppercase tracking-wider text-[10px]">Duration</span>
                  <span class="text-white font-medium">{displayDuration} mins per episode</span>
                </div>
              )}
              {displayRating && (
                <div>
                  <span class="text-neutral-500 block mb-0.5 font-semibold uppercase tracking-wider text-[10px]">Age Rating</span>
                  <span class="text-white font-medium">{displayRating}</span>
                </div>
              )}
              {displayStudios && (
                <div>
                  <span class="text-neutral-500 block mb-0.5 font-semibold uppercase tracking-wider text-[10px]">Studios</span>
                  <span class="text-[var(--brand-color)] font-bold">{displayStudios}</span>
                </div>
              )}
              {displayAuthors && (
                <div>
                  <span class="text-neutral-500 block mb-0.5 font-semibold uppercase tracking-wider text-[10px]">Authors</span>
                  <span class="text-white font-medium">{displayAuthors}</span>
                </div>
              )}
              {displayPublisher && (
                <div>
                  <span class="text-neutral-500 block mb-0.5 font-semibold uppercase tracking-wider text-[10px]">Publisher</span>
                  <span class="text-white font-medium">{displayPublisher}</span>
                </div>
              )}
              {displaySerialization && (
                <div>
                  <span class="text-neutral-500 block mb-0.5 font-semibold uppercase tracking-wider text-[10px]">Serialization</span>
                  <span class="text-white font-medium">{displaySerialization}</span>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>

      {/* ── EPISODES TAB ── */}
      <div id="tab-episodes" class="tab-content hidden">
        <section class="bg-[#111] p-6 rounded-2xl border border-white/5 shadow-lg">
          <h2 class="text-xl font-bold text-white mb-6 border-b border-white/5 pb-2 flex items-center gap-2">
            <span>Episodes</span>
            <span class="text-xs bg-white/5 border border-white/10 px-2 py-0.5 rounded text-neutral-400">{episodes.length} Total</span>
          </h2>
          
          <div class="space-y-4 max-h-[700px] overflow-y-auto pr-2 scrollbar-thin">
            {episodes.map((ep) => (
              <div class="bg-black/30 hover:bg-black/50 border border-white/5 hover:border-[var(--brand-color)]/30 rounded-xl p-4 transition-all duration-300 flex flex-col md:flex-row gap-4 items-center group">
                {/* Ep Thumbnail */}
                <div class="w-full md:w-48 aspect-video rounded-lg overflow-hidden flex-shrink-0 bg-neutral-900 border border-white/5 relative shadow-inner">
                  <img 
                    src={ep.image_url || 'https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?auto=format&fit=crop&w=300&q=80'} 
                    alt={`Episode ${ep.episode_number}`}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                  <div class="absolute bottom-2 left-2 bg-black/60 px-2 py-0.5 rounded text-[10px] font-bold text-white border border-white/10">
                    Ep {ep.episode_number}
                  </div>
                </div>

                {/* Ep Details */}
                <div class="flex-grow">
                  <div class="flex items-center gap-2 mb-1 flex-wrap">
                    <h3 class="font-bold text-white text-base leading-tight group-hover:text-[var(--brand-color)] transition-colors">
                      {ep.title ? ep.title : `Episode ${ep.episode_number}`}
                    </h3>
                    <div class="flex gap-1.5 ml-auto">
                      {ep.sub === 1 && (
                        <span class="text-[9px] bg-emerald-500/20 text-emerald-400 border border-emerald-500/10 px-1.5 py-0.5 rounded font-extrabold tracking-wider">SUB</span>
                      )}
                      {ep.dub === 1 && (
                        <span class="text-[9px] bg-orange-500/20 text-orange-400 border border-orange-500/10 px-1.5 py-0.5 rounded font-extrabold tracking-wider">DUB</span>
                      )}
                    </div>
                  </div>
                  {ep.air_date && (
                    <span class="text-[11px] text-neutral-500 font-medium block mb-2">Aired: {ep.air_date}</span>
                  )}
                  <p class="text-neutral-400 text-xs md:text-sm leading-relaxed line-clamp-2">{ep.description || "No description available for this episode."}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      </div>

      {/* ── CHARACTERS TAB ── */}
      <div id="tab-characters" class="tab-content hidden">
        <section class="bg-[#111] p-6 rounded-2xl border border-white/5 shadow-lg">
          <h2 class="text-xl font-bold text-white mb-6 border-b border-white/5 pb-2">Characters & Voice Actors</h2>
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 max-h-[700px] overflow-y-auto pr-2 scrollbar-thin">
            {characters.map((char) => (
              <div class="bg-black/30 hover:bg-black/50 border border-white/5 hover:border-[var(--brand-color)]/30 rounded-xl p-3 flex justify-between items-center transition-all duration-300 group">
                {/* Left Side: Character info */}
                <div class="flex gap-3">
                  <div class="w-14 h-20 rounded-lg overflow-hidden flex-shrink-0 bg-neutral-900 border border-white/10 shadow-inner">
                    <img 
                      src={char.image_url || 'https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?auto=format&fit=crop&w=150&q=80'} 
                      alt={char.name_full} 
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  </div>
                  <div class="flex flex-col justify-center">
                    <h3 class="font-bold text-white text-sm group-hover:text-[var(--brand-color)] transition-colors leading-tight">{char.name_full}</h3>
                    {char.name_native && (
                      <span class="text-[11px] text-neutral-500 font-medium mb-1">{char.name_native}</span>
                    )}
                    <span class={`text-[10px] font-bold tracking-wider uppercase inline-block w-fit px-1.5 py-0.5 rounded ${
                      char.role === 'MAIN' ? 'bg-red-500/10 text-red-400' : 'bg-neutral-800 text-neutral-400'
                    }`}>{char.role?.toLowerCase()}</span>
                  </div>
                </div>

                {/* Right Side: VA info */}
                {char.voice_actor_name && (
                  <div class="flex gap-3 text-right items-center">
                    <div class="flex flex-col justify-center">
                      <span class="font-bold text-neutral-300 text-xs block leading-tight">{char.voice_actor_name}</span>
                      <span class="text-[9px] text-neutral-500 uppercase tracking-widest font-semibold">Japanese</span>
                    </div>
                    <div class="w-14 h-20 rounded-lg overflow-hidden flex-shrink-0 bg-neutral-900 border border-white/10 shadow-inner">
                      <img 
                        src={char.voice_actor_image || 'https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?auto=format&fit=crop&w=150&q=80'} 
                        alt={char.voice_actor_name} 
                        class="w-full h-full object-cover"
                        loading="lazy"
                      />
                    </div>
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>
      </div>

      {/* ── MEDIA TAB ── */}
      <div id="tab-media" class="tab-content hidden">
        {screenshots.length > 0 && (
          <section class="bg-[#111] p-6 rounded-2xl border border-white/5 shadow-lg mb-6">
            <h2 class="text-xl font-bold text-white mb-6 border-b border-white/5 pb-2">Episode Screenshots</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
              {screenshots.map((s, idx) => (
                <div 
                  class="lightbox-trigger aspect-video rounded-xl overflow-hidden border border-white/5 bg-neutral-900 shadow hover:border-[var(--brand-color)]/50 transition-all duration-300 group block relative cursor-pointer"
                  data-src={s.image_url}
                  data-caption={`Screenshot ${idx + 1}`}
                >
                  <img 
                    src={s.image_url} 
                    alt={`Screenshot ${idx + 1}`} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-all duration-300 backdrop-blur-[2px]">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                    </svg>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        {artworks.length > 0 && (
          <section class="bg-[#111] p-6 rounded-2xl border border-white/5 shadow-lg">
            <h2 class="text-xl font-bold text-white mb-6 border-b border-white/5 pb-2">Production Artworks & Visuals</h2>
            <div class="columns-2 md:columns-3 lg:columns-4 gap-4 space-y-4">
              {artworks.map((art, idx) => (
                <div 
                  class="lightbox-trigger break-inside-avoid bg-[#161616] rounded-xl overflow-hidden border border-white/5 hover:border-[var(--brand-color)]/50 transition-all duration-300 group relative cursor-pointer block"
                  data-src={art.image_url}
                  data-caption={art.type ? `Artwork - ${art.type}` : 'Production Artwork'}
                >
                  <img 
                    src={art.image_url} 
                    alt={`Artwork ${idx + 1}`} 
                    class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-300 block"
                    loading="lazy"
                  />
                  {art.type && (
                    <div class="absolute top-2 left-2 bg-black/60 border border-white/10 px-2 py-0.5 rounded text-[8px] font-bold tracking-wider uppercase text-white z-10">
                      {art.type}
                    </div>
                  )}
                  <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-all duration-300 backdrop-blur-[2px]">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                    </svg>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>

      {/* Fullscreen Lightbox Modal */}
      <div id="lightbox-modal" class="fixed inset-0 z-50 hidden bg-black/95 backdrop-blur-md flex items-center justify-center p-4 select-none">
        <button id="lightbox-close" class="absolute top-6 right-6 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 p-3 rounded-full transition-all z-50">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <button id="lightbox-prev" class="absolute left-6 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 p-4 rounded-full transition-all z-50">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button id="lightbox-next" class="absolute right-6 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 p-4 rounded-full transition-all z-50">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <div class="relative max-w-5xl max-h-[85vh] flex flex-col items-center justify-center">
          <img id="lightbox-img" src="" alt="Fullscreen Visual" class="max-w-full max-h-[80vh] rounded-xl object-contain shadow-2xl border border-white/10" />
          <span id="lightbox-caption" class="text-neutral-400 text-xs mt-3 bg-black/60 px-3 py-1.5 rounded-full border border-white/5 uppercase tracking-wider font-semibold"></span>
        </div>
      </div>

      {/* Recommendations */}
      {recommendations.length > 0 && (
        <section class="border-t border-white/5 pt-8 mb-8">
          <h2 class="text-xl font-bold text-white mb-6">Recommendations</h2>
          <div class="scroll-row">
            {recommendations.map((rec) => (
              <div class="w-44 md:w-56">
                <EntityCard entity={rec} />
              </div>
            ))}
          </div>
        </section>
      )}

      {/* Related News */}
      {articles.length > 0 && (
        <section class="border-t border-white/5 pt-8 mb-8">
          <h2 class="text-xl font-bold text-white mb-6">Related News</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {articles.slice(0, 3).map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        </section>
      )}

      {/* FAQ */}
      {faqItems.length > 0 && (
        <section class="border-t border-white/5 pt-8">
          <h2 class="text-xl font-bold text-white mb-6">FAQ</h2>
          <div class="space-y-4 max-w-3xl">
            {faqItems.map((faq) => (
              <div class="bg-[#111] rounded-xl border border-white/5 p-5">
                <h3 class="font-bold text-white mb-2">{faq.question}</h3>
                <p class="text-neutral-400 text-sm">{faq.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  ) : (
    <div class="glass-dark p-12 rounded-2xl text-center text-neutral-500">
      Entity not found.
    </div>
  )}
</Base>

{/* Interactive Tab Switcher script */}
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.tab-btn');
    const contents = document.querySelectorAll('.tab-content');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');
        
        // Deactivate all
        tabs.forEach(t => {
          t.classList.remove(
            'active',
            'text-[var(--brand-color)]',
            'border-[var(--brand-color)]',
            'bg-[var(--brand-color)]/10'
          );
          t.classList.add('border-transparent', 'text-neutral-400');
        });
        contents.forEach(c => c.classList.add('hidden'));

        // Activate clicked
        tab.classList.remove('border-transparent', 'text-neutral-400');
        tab.classList.add(
          'active',
          'text-[var(--brand-color)]',
          'border-[var(--brand-color)]',
          'bg-[var(--brand-color)]/10'
        );
        
        const targetContent = document.getElementById(`tab-${target}`);
        if (targetContent) targetContent.classList.remove('hidden');
      });
    });
  });
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const sendBtn = document.getElementById('send-btn');
    const chatInput = document.getElementById('chat-input');
    const chatMessages = document.getElementById('chat-messages');

    if (sendBtn && chatInput && chatMessages) {
      const handleSend = async () => {
        const msg = chatInput.value.trim();
        if (!msg) return;

        const entityId = sendBtn.getAttribute('data-id');

        // Add user message
        chatMessages.innerHTML += `
          <div class="text-sm text-white mb-2 leading-relaxed bg-white/5 p-3 rounded-lg border border-white/5">
            <span class="font-bold text-blue-400 block mb-0.5">You:</span> ${msg}
          </div>
        `;
        
        // Add premium typing indicator
        const indicatorId = 'indicator-' + Date.now();
        chatMessages.innerHTML += `
          <div id="${indicatorId}" class="text-sm text-neutral-500 mb-2 animate-pulse flex items-center gap-1">
            <span class="font-bold text-[var(--brand-color)]">AI Representation:</span> Thinking
            <span class="flex gap-0.5">
              <span class="w-1.5 h-1.5 bg-[var(--brand-color)] rounded-full animate-bounce"></span>
              <span class="w-1.5 h-1.5 bg-[var(--brand-color)] rounded-full animate-bounce" style="animation-delay: 0.2s"></span>
              <span class="w-1.5 h-1.5 bg-[var(--brand-color)] rounded-full animate-bounce" style="animation-delay: 0.4s"></span>
            </span>
          </div>
        `;
        
        chatInput.value = '';
        chatInput.disabled = true;
        sendBtn.disabled = true;
        chatMessages.scrollTop = chatMessages.scrollHeight;

        // Fetch from API
        try {
          const res = await fetch(`https://animanga-api.ionicerrrrscode.workers.dev/v1/chat/${entityId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: msg })
          });
          const data = await res.json();
          
          // Remove indicator
          const indicator = document.getElementById(indicatorId);
          if (indicator) {
            indicator.remove();
          }
          
          let replyText = data.data || data.response || data.reply;
          if (!replyText && data.error) {
            replyText = `Error: ${data.error}. ${data.message || ''}`;
          }
          if (!replyText) {
            replyText = "AI could not generate a reply at this time. Please try again later.";
          }
          
          // Add AI response
          chatMessages.innerHTML += `
            <div class="text-sm text-neutral-300 mb-2 leading-relaxed bg-white/5 p-3 rounded-lg border border-white/5">
              <span class="font-bold text-[var(--brand-color)] block mb-1">AI Representation:</span> ${replyText}
            </div>
          `;
        } catch (e) {
          const indicator = document.getElementById(indicatorId);
          if (indicator) indicator.remove();
          chatMessages.innerHTML += `<div class="text-sm text-red-400 mb-2">Error sending message: ${e.message}</div>`;
        } finally {
          chatInput.disabled = false;
          sendBtn.disabled = false;
          chatInput.focus();
          chatMessages.scrollTop = chatMessages.scrollHeight;
        }
      };

      sendBtn.addEventListener('click', handleSend);

      chatInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          handleSend();
        }
      });
    }
  });
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('lightbox-modal');
    const img = document.getElementById('lightbox-img');
    const caption = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    let currentTriggers = [];
    let currentIndex = 0;

    const openLightbox = (triggersArray, index) => {
      currentTriggers = triggersArray;
      currentIndex = index;
      const trigger = currentTriggers[currentIndex];
      const src = trigger.getAttribute('data-src');
      const cap = trigger.getAttribute('data-caption') || '';

      img.src = src;
      caption.textContent = cap;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      img.src = '';
    };

    const navigate = (direction) => {
      if (currentTriggers.length === 0) return;
      currentIndex = (currentIndex + direction + currentTriggers.length) % currentTriggers.length;
      const trigger = currentTriggers[currentIndex];
      img.src = trigger.getAttribute('data-src');
      caption.textContent = trigger.getAttribute('data-caption') || '';
    };

    // Initialize separately for screenshots and artworks so swiping stays inside the tab context
    const setupSection = (selector) => {
      const sectionTriggers = Array.from(document.querySelectorAll(selector));
      sectionTriggers.forEach((trigger, index) => {
        trigger.addEventListener('click', () => openLightbox(sectionTriggers, index));
      });
    };

    setupSection('#tab-media .lightbox-trigger');

    closeBtn?.addEventListener('click', closeLightbox);
    prevBtn?.addEventListener('click', () => navigate(-1));
    nextBtn?.addEventListener('click', () => navigate(1));

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (modal && !modal.classList.contains('hidden')) {
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowRight') navigate(1);
        if (e.key === 'ArrowLeft') navigate(-1);
      }
    });
  });
</script>

