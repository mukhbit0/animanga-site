                    class={`artwork-filter-pill text-xs font-bold px-4 py-1.5 rounded-full border transition-all duration-200 ${f === 'All' ? 'bg-[var(--brand-color)] text-white border-[var(--brand-color)]' : 'bg-white/5 text-neutral-400 border-white/10 hover:bg-white/10 hover:text-white'}`}
                    data-filter={f.toLowerCase()}
                  >
                    {f}
                  </button>
                ))}
