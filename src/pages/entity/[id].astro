        {/* Videos Grid */}
        {videos.length > 0 && (
          <section class="bg-[#111] p-6 rounded-2xl border border-white/5 shadow-lg mb-6">
            <h2 class="text-xl font-bold text-white mb-6 border-b border-white/5 pb-2 flex items-center justify-between">
              <span>Videos</span>
              <span class="text-xs bg-white/5 border border-white/10 px-2 py-0.5 rounded text-neutral-400 font-medium">{videos.length} Videos</span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
              {videos.map((v, idx) => {
                const rawUrl = (v.url || '').toString();
                const ytMatch = rawUrl.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=))([\w-]{11})/);
                const ytId = ytMatch ? ytMatch[1] : null;
                const thumb = v.thumbnail
                  ? (v.thumbnail.startsWith('//') ? 'https:' + v.thumbnail : v.thumbnail)
                  : (ytId ? `https://img.youtube.com/vi/${ytId}/mqdefault.jpg` : null);
                const typeLabel = (v.type || '').replace(/_/g, ' ').toUpperCase() || 'VIDEO';
