            </div>
            <div class="columns-2 md:columns-3 lg:columns-4 gap-4 space-y-4" id="artworks-grid">
              {artworks.map((art, idx) => (
                <div
                  class={`artwork-item lightbox-trigger break-inside-avoid bg-[#161616] rounded-xl overflow-hidden border border-white/5 hover:border-[var(--brand-color)]/50 transition-all duration-300 group relative cursor-pointer ${idx >= 16 ? 'hidden artwork-hidden-item' : 'block'}`}
