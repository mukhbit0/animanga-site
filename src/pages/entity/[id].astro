                      <div class="flex items-start gap-2 mb-2">
                        <span class="text-[10px] font-bold tracking-widest uppercase px-2 py-0.5 rounded bg-[var(--brand-color)]/15 text-[var(--brand-color)] border border-[var(--brand-color)]/20 shrink-0 mt-0.5">{typeLabel}</span>
                        {sourceLabel && <span class="text-[10px] font-semibold uppercase px-2 py-0.5 rounded bg-white/5 text-neutral-500 border border-white/5 shrink-0 mt-0.5">{sourceLabel}</span>}
