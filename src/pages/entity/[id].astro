                >
                  <img
                    src={art.image_url}
                    alt={`Artwork ${idx + 1}`}
                    class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-300 block"
                    loading="lazy"
                  />
                  {art.type && (
                    <div class="absolute top-2 left-2 bg-black/60 border border-white/10 px-2 py-0.5 rounded text-[8px] font-bold tracking-wider uppercase text-white z-10">
                      {art.type}
