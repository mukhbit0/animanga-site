                >
                  <span>Load More Artworks</span>
                  <span class="text-xs bg-white/10 px-2 py-0.5 rounded text-neutral-400 font-medium" id="load-more-count">+{artworks.length - 16}</span>
                </button>
              </div>
            )}
          </section>
        )}
      </div>

      {/* Fullscreen Lightbox Modal */}
      <div id="lightbox-modal" class="fixed inset-0 z-50 hidden bg-black/95 backdrop-blur-md flex items-center justify-center p-4 select-none">
        <button id="lightbox-close" class="absolute top-6 right-6 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 p-3 rounded-full transition-all z-50">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <button id="lightbox-prev" class="absolute left-6 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 p-4 rounded-full transition-all z-50">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button id="lightbox-next" class="absolute right-6 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 p-4 rounded-full transition-all z-50">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <div class="relative max-w-5xl max-h-[85vh] flex flex-col items-center justify-center">
          <img id="lightbox-img" src="" alt="Fullscreen Visual" class="max-w-full max-h-[80vh] rounded-xl object-contain shadow-2xl border border-white/10" />
          <span id="lightbox-caption" class="text-neutral-400 text-xs mt-3 bg-black/60 px-3 py-1.5 rounded-full border border-white/5 uppercase tracking-wider font-semibold"></span>
        </div>
      </div>

      {/* Recommendations */}
      {recommendations.length > 0 && (
        <section class="border-t border-white/5 pt-8 mb-8">
          <h2 class="text-xl font-bold text-white mb-6">Recommendations</h2>
          <div class="scroll-row">
            {recommendations.map((rec) => (
              <div class="w-44 md:w-56">
                <EntityCard entity={rec} />
              </div>
            ))}
          </div>
        </section>
      )}

      {/* Related News */}
      {articles.length > 0 && (
        <section class="border-t border-white/5 pt-8 mb-8">
          <h2 class="text-xl font-bold text-white mb-6">Related News</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {articles.slice(0, 3).map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        </section>
      )}

      {/* FAQ */}
      {faqItems.length > 0 && (
        <section class="border-t border-white/5 pt-8">
          <h2 class="text-xl font-bold text-white mb-6">FAQ</h2>
          <div class="space-y-4 max-w-3xl">
            {faqItems.map((faq) => (
              <div class="bg-[#111] rounded-xl border border-white/5 p-5">
                <h3 class="font-bold text-white mb-2">{faq.question}</h3>
                <p class="text-neutral-400 text-sm">{faq.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  ) : (
    <div class="glass-dark p-12 rounded-2xl text-center text-neutral-500">
      Entity not found.
    </div>
  )}
</Base>

{/* Interactive Tab Switcher script */}
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.tab-btn');
    const contents = document.querySelectorAll('.tab-content');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');
        
        // Deactivate all
        tabs.forEach(t => {
          t.classList.remove(
            'active',
            'text-[var(--brand-color)]',
            'border-[var(--brand-color)]',
            'bg-[var(--brand-color)]/10'
          );
          t.classList.add('border-transparent', 'text-neutral-400');
        });
        contents.forEach(c => c.classList.add('hidden'));

        // Activate clicked
        tab.classList.remove('border-transparent', 'text-neutral-400');
        tab.classList.add(
          'active',
          'text-[var(--brand-color)]',
          'border-[var(--brand-color)]',
          'bg-[var(--brand-color)]/10'
        );
        
        const targetContent = document.getElementById(`tab-${target}`);
        if (targetContent) targetContent.classList.remove('hidden');
      });
    });
  });
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const sendBtn = document.getElementById('send-btn');
    const chatInput = document.getElementById('chat-input');
    const chatMessages = document.getElementById('chat-messages');

    if (sendBtn && chatInput && chatMessages) {
      const handleSend = async () => {
        const msg = chatInput.value.trim();
        if (!msg) return;

        const entityId = sendBtn.getAttribute('data-id');

        // Add user message
        chatMessages.innerHTML += `
          <div class="text-sm text-white mb-2 leading-relaxed bg-white/5 p-3 rounded-lg border border-white/5">
            <span class="font-bold text-blue-400 block mb-0.5">You:</span> ${msg}
          </div>
        `;
        
        // Add premium typing indicator
        const indicatorId = 'indicator-' + Date.now();
        chatMessages.innerHTML += `
          <div id="${indicatorId}" class="text-sm text-neutral-500 mb-2 animate-pulse flex items-center gap-1">
            <span class="font-bold text-[var(--brand-color)]">AI Representation:</span> Thinking
            <span class="flex gap-0.5">
              <span class="w-1.5 h-1.5 bg-[var(--brand-color)] rounded-full animate-bounce"></span>
              <span class="w-1.5 h-1.5 bg-[var(--brand-color)] rounded-full animate-bounce" style="animation-delay: 0.2s"></span>
              <span class="w-1.5 h-1.5 bg-[var(--brand-color)] rounded-full animate-bounce" style="animation-delay: 0.4s"></span>
            </span>
          </div>
        `;
        
        chatInput.value = '';
        chatInput.disabled = true;
        sendBtn.disabled = true;
        chatMessages.scrollTop = chatMessages.scrollHeight;

        // Fetch from API
        try {
          const res = await fetch(`https://animanga-api.ionicerrrrscode.workers.dev/v1/chat/${entityId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: msg })
          });
          const data = await res.json();
          
          // Remove indicator
          const indicator = document.getElementById(indicatorId);
          if (indicator) {
            indicator.remove();
          }
          
          let replyText = data.data || data.response || data.reply;
          if (!replyText && data.error) {
            replyText = `Error: ${data.error}. ${data.message || ''}`;
          }
          if (!replyText) {
            replyText = "AI could not generate a reply at this time. Please try again later.";
          }
          
          // Add AI response
          chatMessages.innerHTML += `
            <div class="text-sm text-neutral-300 mb-2 leading-relaxed bg-white/5 p-3 rounded-lg border border-white/5">
              <span class="font-bold text-[var(--brand-color)] block mb-1">AI Representation:</span> ${replyText}
            </div>
          `;
        } catch (e) {
          const indicator = document.getElementById(indicatorId);
          if (indicator) indicator.remove();
          chatMessages.innerHTML += `<div class="text-sm text-red-400 mb-2">Error sending message: ${e.message}</div>`;
        } finally {
          chatInput.disabled = false;
          sendBtn.disabled = false;
          chatInput.focus();
          chatMessages.scrollTop = chatMessages.scrollHeight;
        }
      };

      sendBtn.addEventListener('click', handleSend);

      chatInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          handleSend();
        }
      });
    }
  });
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('lightbox-modal');
    const img = document.getElementById('lightbox-img');
    const caption = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    let currentTriggers = [];
    let currentIndex = 0;

    const openLightbox = (triggersArray, index) => {
      currentTriggers = triggersArray;
      currentIndex = index;
      const trigger = currentTriggers[currentIndex];
      img.src = trigger.getAttribute('data-src');
      caption.textContent = trigger.getAttribute('data-caption') || '';
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      img.src = '';
    };

    const navigate = (direction) => {
      if (currentTriggers.length === 0) return;
      currentIndex = (currentIndex + direction + currentTriggers.length) % currentTriggers.length;
      const trigger = currentTriggers[currentIndex];
      img.src = trigger.getAttribute('data-src');
      caption.textContent = trigger.getAttribute('data-caption') || '';
    };

    // Register lightbox for a specific selector (re-clones nodes to remove old listeners)
    const setupLightbox = (selector) => {
      const items = Array.from(document.querySelectorAll(selector));
      items.forEach((trigger, index) => {
        const fresh = trigger.cloneNode(true);
        trigger.parentNode.replaceChild(fresh, trigger);
        fresh.addEventListener('click', () => openLightbox(
          Array.from(document.querySelectorAll(selector)),
          index
        ));
      });
    };

    // Screenshots in Overview tab (isolated scope)
    setupLightbox('#tab-overview .lightbox-trigger');

    // Artworks in Media tab (scoped to visible artworks only)
    const setupArtworkLightbox = () => {
      const visibleArtworks = Array.from(document.querySelectorAll('#tab-media .artwork-item:not(.hidden)'));
      visibleArtworks.forEach((trigger, index) => {
        const fresh = trigger.cloneNode(true);
        trigger.parentNode.replaceChild(fresh, trigger);
        fresh.addEventListener('click', () => openLightbox(
          Array.from(document.querySelectorAll('#tab-media .artwork-item:not(.hidden)')),
          index
        ));
      });
    };
    setupArtworkLightbox();

    // ── Artwork Filter Pills ──
    const pills = document.querySelectorAll('.artwork-filter-pill');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        const filter = pill.getAttribute('data-filter');

        // Update active pill style
        pills.forEach(p => {
          p.classList.remove('bg-[var(--brand-color)]', 'text-white', 'border-[var(--brand-color)]');
          p.classList.add('bg-white/5', 'text-neutral-400', 'border-white/10');
        });
        pill.classList.remove('bg-white/5', 'text-neutral-400', 'border-white/10');
        pill.classList.add('bg-[var(--brand-color)]', 'text-white', 'border-[var(--brand-color)]');

        // Show/hide artworks based on filter (only non-hidden-by-load-more items)
        const allArtworks = Array.from(document.querySelectorAll('#tab-media .artwork-item'));
        allArtworks.forEach(item => {
          if (item.classList.contains('artwork-hidden-item')) return; // respect load-more state
          const type = (item.getAttribute('data-artwork-type') || '').toLowerCase();
          const match = filter === 'all' || type === filter || type.includes(filter);
          item.classList.toggle('hidden', !match);
          item.style.opacity = match ? '1' : '0';
          item.style.transform = match ? 'scale(1)' : 'scale(0.95)';
          item.style.transition = 'opacity 0.2s, transform 0.2s';
        });

        // Re-init lightbox for newly visible artworks
        setTimeout(setupArtworkLightbox, 50);
      });
    });

    // ── Load More Artworks ──
    const loadMoreBtn = document.getElementById('load-more-artworks-btn');
    const loadMoreContainer = document.getElementById('load-more-artworks-container');
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        const hidden = Array.from(document.querySelectorAll('.artwork-hidden-item'));
        const batch = hidden.slice(0, 16);
        batch.forEach(item => {
          item.classList.remove('hidden', 'artwork-hidden-item');
          item.classList.add('block');
        });
        setupArtworkLightbox();
        const remaining = hidden.length - batch.length;
        if (remaining <= 0) {
          loadMoreContainer?.remove();
        } else {
          const badge = document.getElementById('load-more-count');
          if (badge) badge.textContent = `+${remaining}`;
        }
      });
    }

    // ── Inline Video Player ──
    document.querySelectorAll('.video-thumb-wrap').forEach(wrap => {
      wrap.addEventListener('click', () => {
        const card = wrap.closest('.video-card');
        if (!card) return;
        const ytId = card.getAttribute('data-yt-id');
        const rawUrl = card.getAttribute('data-video-url') || '';
        const embedContainer = wrap.querySelector('.video-embed-container');
        const iframe = embedContainer?.querySelector('iframe');
        if (!iframe) return;

        // Build embed URL
        let embedUrl = '';
        if (ytId) {
          embedUrl = `https://www.youtube.com/embed/${ytId}?autoplay=1&rel=0`;
        } else if (rawUrl.includes('vk.com')) {
          // Convert vk.com/video-xxx_yyy to embed
          const vkMatch = rawUrl.match(/video(-?\d+_\d+)/);
          embedUrl = vkMatch ? `https://vk.com/video_ext.php?oid=${vkMatch[1].split('_')[0]}&id=${vkMatch[1].split('_')[1]}&hd=2&autoplay=1` : rawUrl;
        } else {
          embedUrl = rawUrl;
        }

        iframe.src = embedUrl;
        embedContainer.classList.remove('hidden');
        // Hide the play overlay
        const playOverlay = wrap.querySelector('.absolute.inset-0');
        if (playOverlay) playOverlay.style.display = 'none';
        const thumbImg = wrap.querySelector('img');
        if (thumbImg) thumbImg.style.display = 'none';
        const thumbFallback = wrap.querySelector('.bg-gradient-to-br');
        if (thumbFallback) thumbFallback.style.display = 'none';
      });
    });

    closeBtn?.addEventListener('click', closeLightbox);
    prevBtn?.addEventListener('click', () => navigate(-1));
    nextBtn?.addEventListener('click', () => navigate(1));
    modal?.addEventListener('click', (e) => { if (e.target === modal) closeLightbox(); });
    document.addEventListener('keydown', (e) => {
      if (modal && !modal.classList.contains('hidden')) {
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowRight') navigate(1);
        if (e.key === 'ArrowLeft') navigate(-1);
      }
    });
  });
</script>



