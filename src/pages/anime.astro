---
import Base from '../layouts/Base.astro';
import EntityCard from '../components/EntityCard.astro';
import { getCatalog } from '../lib/api';

const type = 'anime';
const sort   = Astro.url.searchParams.get('sort')   || 'score';
const status = Astro.url.searchParams.get('status') || '';
const genre  = Astro.url.searchParams.get('genre')  || '';
const pageParam = Astro.url.searchParams.get('page') || '1';
const page = Math.max(parseInt(pageParam), 1);

const PAGE_SIZE = 28;

let entities: any[] = [];
let total = 0;
let hasMore = false;
let error: string | null = null;

try {
  const res = await getCatalog(type, sort, status, genre, PAGE_SIZE, page);
  entities = res.data || [];
  total = res.total || 0;
  hasMore = res.hasMore || false;
} catch (e: any) {
  error = e.message;
}

// Build a URL that preserves ALL current params but swaps one key
function buildUrl(overrides: Record<string, string>) {
  const params = new URLSearchParams();
  if (sort)   params.set('sort',   sort);
  if (status) params.set('status', status);
  if (genre)  params.set('genre',  genre);
  if (page > 1) params.set('page', page.toString());
  
  for (const [k, v] of Object.entries(overrides)) {
    if (v) params.set(k, v);
    else   params.delete(k);
  }
  const qs = params.toString();
  return `/${type}${qs ? '?' + qs : ''}`;
}

const isFiltered = sort !== 'score' || !!status || !!genre;
const totalPages = Math.ceil(total / PAGE_SIZE);

// Helper to generate smart numbered pagination list
function getPageRange(current: number, totalPagesCount: number) {
  const range: (number | string)[] = [];
  const delta = 2; // Pages to show around current page
  
  for (let i = 1; i <= totalPagesCount; i++) {
    if (i === 1 || i === totalPagesCount || (i >= current - delta && i <= current + delta)) {
      range.push(i);
    } else if (range[range.length - 1] !== '...') {
      range.push('...');
    }
  }
  return range;
}
const pageRange = getPageRange(page, totalPages);
---
<Base title="Anime Catalog" description="Explore all anime series, movies, and episodes in our database." fullWidth={true}>
  
  <style>
    .catalog-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
    @media (min-width: 640px) {
      .catalog-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }
    @media (min-width: 1024px) {
      .catalog-grid {
        grid-template-columns: repeat(7, 1fr);
      }
    }
  </style>

  <div class="container mx-auto px-4 max-w-[1600px] py-8">
    <div class="mb-10">
      <h1 style="font-size: 2.25rem; font-weight: 900; color: #fff; text-transform: uppercase; letter-spacing: -0.02em; margin: 0 0 0.5rem; display: flex; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
        {type} <span style="font-size: 11px; font-weight: 800; color: #e85d04; background: rgba(232,93,4,0.1); border: 1px solid rgba(232,93,4,0.2); padding: 5px 14px; border-radius: 99px; letter-spacing: 0.05em; text-transform: uppercase; vertical-align: middle;">{total.toLocaleString()} titles</span>
      </h1>
      <p style="color: rgba(255,255,255,0.4); font-size: 0.95rem; margin: 0;">Explore our fully comprehensive, top-rated database of {type} series and movies.</p>
    </div>

    {/* ── Filter Bar ── */}
    <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 1rem; padding: 0.875rem 1.25rem; margin-bottom: 2rem;">
      <div style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: center;">
        
        {/* Sort */}
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span style="font-size: 10px; font-weight: 700; color: rgba(255,255,255,0.35); text-transform: uppercase; letter-spacing: 0.07em;">Sort</span>
          <div style="display: flex; gap: 4px;">
            {[['score','Top Rated'],['popularity','Popular'],['new','Newest']].map(([val, label]) => (
              <a
                href={buildUrl({ sort: val, page: '1' })}
                style={`font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 6px; text-decoration: none; transition: all 0.2s; ${sort === val ? 'background: #e85d04; color: #fff;' : 'background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.5);'}`}
              >
                {label}
              </a>
            ))}
          </div>
        </div>

        {/* Status */}
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span style="font-size: 10px; font-weight: 700; color: rgba(255,255,255,0.35); text-transform: uppercase; letter-spacing: 0.07em;">Status</span>
          <div style="display: flex; gap: 4px;">
            {[['','All'],['ongoing','Ongoing'],['finished','Finished'],['completed','Completed']].map(([val, label]) => (
              <a
                href={buildUrl({ status: val, page: '1' })}
                style={`font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 6px; text-decoration: none; transition: all 0.2s; ${status === val ? 'background: rgba(232,93,4,0.9); color: #fff;' : 'background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.5);'}`}
              >
                {label}
              </a>
            ))}
          </div>
        </div>
      </div>

      {isFiltered && (
        <a href={`/${type}`} style="font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.35); text-decoration: none; padding: 4px 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.08); transition: all 0.2s;" onmouseover="this.style.color='#e85d04';this.style.borderColor='rgba(232,93,4,0.3)'" onmouseout="this.style.color='rgba(255,255,255,0.35)';this.style.borderColor='rgba(255,255,255,0.08)'">
          ✕ Reset
        </a>
      )}
    </div>

    {error && (
      <div style="background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2); padding: 1rem 1.25rem; border-radius: 0.75rem; color: #f87171; margin-bottom: 1.5rem; font-size: 0.875rem;">
        Error: {error}
      </div>
    )}

    {entities.length === 0 && !error && (
      <div style="text-align: center; padding: 4rem 2rem; color: rgba(255,255,255,0.25); border: 1px solid rgba(255,255,255,0.05); border-radius: 1.25rem;">
        No {type} entries match the selected filters.
      </div>
    )}

    {entities.length > 0 && (
      <div class="catalog-grid">
        {entities.map((item: any) => (
          <EntityCard entity={item} />
        ))}
      </div>
    )}

    {/* ── Premium Numbered Pagination ── */}
    {totalPages > 1 && (
      <div style="display: flex; flex-direction: column; align-items: center; gap: 0.75rem; margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.05);">
        
        <div style="display: flex; align-items: center; justify-content: center; gap: 0.35rem; flex-wrap: wrap;">
          {/* Previous Page */}
          {page > 1 ? (
            <a href={buildUrl({ page: (page - 1).toString() })} style="display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: rgba(255,255,255,0.6); text-decoration: none; min-width: 40px; height: 40px; padding: 0 16px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.03); transition: all 0.2s;" onmouseover="this.style.color='#fff';this.style.borderColor='rgba(255,255,255,0.18)'" onmouseout="this.style.color='rgba(255,255,255,0.6)';this.style.borderColor='rgba(255,255,255,0.08)'">
              Prev
            </a>
          ) : (
            <span style="display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: rgba(255,255,255,0.15); min-width: 40px; height: 40px; padding: 0 16px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.03); background: transparent; cursor: not-allowed;">
              Prev
            </span>
          )}

          {/* Page numbers */}
          {pageRange.map((p) => {
            if (p === '...') {
              return (
                <span style="display: flex; align-items: center; justify-content: center; min-width: 40px; height: 40px; font-size: 13px; font-weight: 700; color: rgba(255,255,255,0.25);">
                  ...
                </span>
              );
            }
            const isCurrent = p === page;
            return (
              <a
                href={buildUrl({ page: p.toString() })}
                style={`display: flex; align-items: center; justify-content: center; min-width: 40px; height: 40px; font-size: 13px; font-weight: 700; text-decoration: none; border-radius: 8px; transition: all 0.2s; ${isCurrent ? 'background: #e85d04; color: #fff; box-shadow: 0 4px 12px rgba(232,93,4,0.25); border: 1px solid #e85d04;' : 'background: rgba(255,255,255,0.03); color: rgba(255,255,255,0.6); border: 1px solid rgba(255,255,255,0.08);'}`}
                onmouseover={!isCurrent ? "this.style.color='#fff';this.style.borderColor='rgba(255,255,255,0.18)'" : ""}
                onmouseout={!isCurrent ? "this.style.color='rgba(255,255,255,0.6)';this.style.borderColor='rgba(255,255,255,0.08)'" : ""}
              >
                {p}
              </a>
            );
          })}

          {/* Next Page */}
          {hasMore ? (
            <a href={buildUrl({ page: (page + 1).toString() })} style="display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: rgba(255,255,255,0.6); text-decoration: none; min-width: 40px; height: 40px; padding: 0 16px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.03); transition: all 0.2s;" onmouseover="this.style.color='#fff';this.style.borderColor='rgba(255,255,255,0.18)'" onmouseout="this.style.color='rgba(255,255,255,0.6)';this.style.borderColor='rgba(255,255,255,0.08)'">
              Next
            </a>
          ) : (
            <span style="display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: rgba(255,255,255,0.15); min-width: 40px; height: 40px; padding: 0 16px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.03); background: transparent; cursor: not-allowed;">
              Next
            </span>
          )}
        </div>

        <div style="font-size: 11px; font-weight: 600; color: rgba(255,255,255,0.25); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.25rem;">
          Showing {((page - 1) * PAGE_SIZE + 1).toLocaleString()} - {Math.min(page * PAGE_SIZE, total).toLocaleString()} of {total.toLocaleString()} titles
        </div>
      </div>
    )}
  </div>
</Base>
