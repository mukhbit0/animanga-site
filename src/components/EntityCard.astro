---
const { entity, size = 'default' } = Astro.props;
const isSmall = size === 'small';
const isMedium = size === 'medium';

const imageUrl = (entity.image_url && entity.image_url !== 'null' && entity.image_url !== 'undefined' && entity.image_url.trim() !== '')
  ? entity.image_url
  : entity.type === 'person' ? 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=300&h=300&q=80'
  : entity.type === 'company' ? 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=300&h=300&q=80'
  : 'https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?auto=format&fit=crop&w=300&q=80';

const typeColor =
  entity.type === 'anime'  ? 'bg-blue-500/10 text-blue-400 border-blue-500/20' :
  entity.type === 'manga'  ? 'bg-green-500/10 text-green-400 border-green-500/20' :
  entity.type === 'person' ? 'bg-amber-500/10 text-amber-400 border-amber-500/20' :
  entity.type === 'company' ? 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20' :
                             'bg-pink-500/10 text-pink-400 border-pink-500/20';

const subLabel = 
  entity.type === 'person' ? 'Staff / Creator' :
  entity.type === 'company' ? 'Production Studio' :
  entity.year ? `${entity.year}` : 
  entity.status ? `${entity.status}` : 'Entity';
---

<a href={`/entity/${entity.internal_id}`} class="group block h-full">
  <div class={`glass-dark rounded-xl overflow-hidden border border-white/5 hover:border-[#e85d04]/40 transition-all duration-300 hover:shadow-lg hover:shadow-[#e85d04]/5 flex ${isSmall ? 'flex-row gap-3 p-3 items-center h-full' : isMedium ? 'flex-row gap-3 p-3 items-center h-full' : 'flex-col h-full'}`}>
    
    {/* Cover Image */}
    <div class={`overflow-hidden bg-neutral-900 rounded-lg flex-shrink-0 ${isSmall ? 'w-12 h-16' : isMedium ? 'w-14 h-20' : 'aspect-[2/3] w-full'}`}>
      <img
        src={imageUrl}
        alt={entity.title_canonical}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    </div>
    
    {/* Info Container for Small/Medium horizontal style */}
    {(isSmall || isMedium) ? (
      <div class="flex-grow min-w-0 overflow-hidden">
        <span class={`inline-block uppercase tracking-wider font-bold rounded px-1.5 py-0.5 mb-1.5 border ${typeColor} text-[8px]`}>
          {entity.type}
        </span>
        <h3 class="font-extrabold text-white group-hover:text-[#e85d04] transition-colors leading-snug text-xs truncate" title={entity.title_canonical}>
          {entity.title_canonical}
        </h3>
        <p class="text-[10px] text-neutral-500 mt-0.5 font-medium truncate">
          {subLabel}
        </p>
      </div>
    ) : (
      /* Full card style for default/large */
      <div class="p-4 flex flex-col flex-grow justify-between">
        <div>
          <span class={`inline-block uppercase tracking-wider font-bold rounded px-1.5 py-0.5 mb-2 border ${typeColor} text-[9px]`}>
            {entity.type}
          </span>
          <h3 class="font-extrabold text-white group-hover:text-[#e85d04] transition-colors leading-snug text-sm line-clamp-2 mb-2">
            {entity.title_canonical}
          </h3>
        </div>
        
        <div class="flex items-center justify-between mt-2 border-t border-white/5 pt-2 text-[10px] text-neutral-500 font-medium">
          <span>{subLabel}</span>
          {entity.mal_score && (
            <span class="flex items-center gap-0.5 text-yellow-500 font-bold">
              <svg class="w-3 h-3 text-yellow-500 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              {entity.mal_score}
            </span>
          )}
        </div>
      </div>
    )}

  </div>
</a>
