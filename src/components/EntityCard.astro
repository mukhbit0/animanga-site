---
const { entity, size = 'default' } = Astro.props;
const isSmall = size === 'small';
---
<a href={`/entity/${entity.internal_id}`} class="group block h-full">
  <div class={`relative bg-[#111] rounded-xl overflow-hidden border border-white/5 hover:border-[#e85d04]/50 transition-all duration-300 hover:scale-[1.02] h-full ${isSmall ? 'flex gap-3 p-3' : ''}`}>
    
    {/* Cover Image with Fallback */}
    <div class={`overflow-hidden ${isSmall ? 'w-14 h-20 rounded-lg flex-shrink-0' : 'aspect-[2/3]'} bg-neutral-900 border-b border-white/5`}>
      <img 
        src={entity.image_url && entity.image_url.trim() !== "" && entity.image_url !== "null" && entity.image_url !== "undefined" ? entity.image_url : 'https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?auto=format&fit=crop&w=300&q=80'} 
        alt={entity.title_canonical} 
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
        loading="lazy"
      />
    </div>

    <div class={isSmall ? 'flex flex-col justify-center min-w-0' : 'p-4'}>
      {/* Type Badge */}
      <span class={`inline-block uppercase tracking-wider font-bold rounded px-1.5 py-0.5 mb-1.5 ${
        entity.type === 'anime' ? 'bg-blue-500/20 text-blue-400' :
        entity.type === 'manga' ? 'bg-green-500/20 text-green-400' :
        entity.type === 'manhwa' ? 'bg-purple-500/20 text-purple-400' :
        'bg-pink-500/20 text-pink-400'
      } ${isSmall ? 'text-[9px]' : 'text-[10px]'}`}>
        {entity.type}
      </span>

      {/* Title */}
      <h3 class={`font-bold text-white group-hover:text-[#e85d04] transition-colors leading-tight ${isSmall ? 'text-sm truncate' : 'text-sm mb-2 line-clamp-2'}`}>
        {entity.title_canonical}
      </h3>

      {!isSmall && (
        <div class="flex items-center gap-2 text-xs text-neutral-400">
          {entity.mal_score && (
            <span class="flex items-center gap-0.5">
              <svg class="w-3 h-3 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              {entity.mal_score}
            </span>
          )}
          {entity.year && <span>{entity.year}</span>}
          {entity.status && (
            <span class={`flex items-center gap-1 ${entity.status === 'ongoing' ? 'text-green-400' : 'text-neutral-500'}`}>
              <span class={`w-1.5 h-1.5 rounded-full ${entity.status === 'ongoing' ? 'bg-green-400' : 'bg-neutral-500'}`}></span>
              <span class="capitalize">{entity.status}</span>
            </span>
          )}
        </div>
      )}
    </div>
  </div>
</a>
